<file path="utilizer-ruby/lib/utilizer/web/assets/lib/positioning.js">
const virtualElementAt = (x, y) => ({
  getBoundingClientRect: () => ({
    x,
    y,
    left: x,
    top: y,
    right: x,
    bottom: y,
    width: 0,
    height: 0,
  }),
});

export const positionContextMenu = async (menu, event) => {
  if (!menu || !window.FloatingUIDOM) return false;

  const { computePosition, offset, flip, shift } = window.FloatingUIDOM;
  const { x, y } = await computePosition(
    virtualElementAt(event.clientX, event.clientY),
    menu,
    {
      placement: "right-start",
      middleware: [offset(4), flip(), shift({ padding: 8 })],
    },
  );

  Object.assign(menu.style, {
    left: `${x}px`,
    top: `${y}px`,
  });
  return true;
};
