# frozen_string_literal: true

class Utilizer
  module PathNormalizer
    module_function

    def normalize(path)
      value = path.to_s.strip
      return "" if value.empty?

      value = value[1...-1] if quoted?(value)
      value = value.strip
      return "" if value.empty?

      value = value.gsub("\t", "/t")
                   .gsub("\r", "/r")
                   .gsub("\n", "/n")
                   .gsub("\b", "/b")
                   .gsub("\f", "/f")
      value = value.tr("\\", "/")
      prefix = value.start_with?("//") ? "//" : ""
      value = prefix + value.delete_prefix("//").gsub(%r{/+}, "/")
      value = value.sub(%r{/\z}, "") while value.length > 3 && value.end_with?("/")
      File.expand_path(value).tr("\\", "/")
    end

    def normalize_cs2_cfg(path)
      cleaned = normalize(path)
      return "" if cleaned.empty?

      csgo_cfg = File.join(cleaned, "cfg").tr("\\", "/")
      return csgo_cfg if File.basename(cleaned).casecmp?("csgo") && Dir.exist?(csgo_cfg)

      cleaned
    end

    def cs2_cfg_shape?(path)
      cleaned = normalize(path)
      !cleaned.empty? && cleaned.downcase.end_with?("/game/csgo/cfg")
    end

    def cs2_game_folder(path)
      cfg_folder = normalize_cs2_cfg(path)
      return "" if cfg_folder.empty?

      File.expand_path("..", cfg_folder).tr("\\", "/")
    end

    def quoted?(value)
      value.length >= 2 &&
        ((value.start_with?('"') && value.end_with?('"')) ||
         (value.start_with?("'") && value.end_with?("'")))
    end
    private_class_method :quoted?
  end
end
