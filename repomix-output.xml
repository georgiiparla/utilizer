export const requestConfirm = ({
  title,
  body,
  actionLabel = "Confirm",
  actionClass = "btn-neutral",
  onConfirm,
}) => {
  const event = new CustomEvent("utilizer:confirm", {
    detail: { title, body, actionLabel, actionClass, onConfirm },
