# frozen_string_literal: true

require "fileutils"
require "json"
require "net/http"
require "time"

class Utilizer
  class WebRegistry
    STARTING_GRACE_SECONDS = 10
    HTTP_TIMEOUT_SECONDS = 0.5

    def initialize(config)
      @path = config.web_registry_path
    end

    def active
      record = read
      return nil unless record
      return record if healthy?(record)
      return record if starting?(record) && process_running?(record["pid"])

      clear
      nil
    end

    def write(record)
      FileUtils.mkdir_p(File.dirname(@path))
      File.write(@path, "#{JSON.pretty_generate(record)}\n", encoding: "UTF-8")
    end

    def clear_if_pid(pid)
      record = read
      clear if record && record["pid"].to_i == pid.to_i
    end

    def clear
      FileUtils.rm_f(@path)
    end

    private

    def read
      return nil unless File.exist?(@path)

      JSON.parse(File.read(@path, encoding: "UTF-8"))
    rescue JSON::ParserError
      clear
      nil
    end

    def healthy?(record)
      return false unless process_running?(record["pid"])

      uri = URI(record.fetch("url"))
      uri.path = "/health"
      uri.query = nil
      response = http_get(uri)
      response.is_a?(Net::HTTPSuccess) && response.body.to_s.strip == "ok"
    rescue KeyError, URI::InvalidURIError
      false
    end

    def http_get(uri)
      http = Net::HTTP.new(uri.host, uri.port)
      http.open_timeout = HTTP_TIMEOUT_SECONDS
      http.read_timeout = HTTP_TIMEOUT_SECONDS
      http.get(uri.request_uri)
    rescue IOError, SystemCallError, Timeout::Error
      nil
    end

    def process_running?(pid)
      return false if pid.to_i <= 0

      Process.kill(0, pid.to_i)
      true
    rescue Errno::ESRCH, Errno::EINVAL
      false
    rescue Errno::EPERM
      true
    end

    def starting?(record)
      started_at = Time.iso8601(record.fetch("started_at"))
      Time.now.utc - started_at <= STARTING_GRACE_SECONDS
    rescue KeyError, ArgumentError
      false
    end
  end
end
