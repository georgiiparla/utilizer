export const normalizeSearchText = (value) =>
  String(value || "").trim().toLocaleLowerCase();

export const searchTerms = (value) =>
  normalizeSearchText(value).split(/\s+/).filter(Boolean);

export const matchesSearch = (text, terms) => {
  if (terms.length === 0) return true;

  const normalizedText = normalizeSearchText(text);
  return terms.every((term) => normalizedText.includes(term));
};

export const setVisible = (element, visible) => {
  element.hidden = !visible;
  element.classList.toggle("hidden", !visible);
  element.style.display = visible ? "" : "none";
};

export const applyTextFilter = ({ input, targets, getText, onFiltered }) => {
  if (!input || !targets || !getText) return { query: "", visible: 0, total: 0 };

  const terms = searchTerms(input.value);
  let visible = 0;

  targets.forEach((target) => {
    const show = matchesSearch(getText(target), terms);
    setVisible(target, show);
    if (show) visible += 1;
  });

  const result = {
    query: normalizeSearchText(input.value),
    visible,
    total: targets.length,
  };
  if (onFiltered) onFiltered(result);
  return result;
};

export const clearSearchInput = (input) => {
  if (!input || input.value === "") return false;

  input.value = "";
  return true;
};
