# frozen_string_literal: true

require "csv"

require_relative "command_validator"
require_relative "maps"
require_relative "playlist_alias"

class Utilizer
  class PlaylistFile
    Spot = Struct.new(:index, :command, :description, :yaw, keyword_init: true)
    SkippedRow = Struct.new(:row_number, :reason, :command, :description, keyword_init: true)

    attr_reader :name, :path, :spots, :skipped_rows, :map_name, :map_code

    def self.load(path, map_code: nil)
      rows = CSV.read(path, headers: true, encoding: "bom|utf-8")
      spots = []
      skipped_rows = []
      map_name = map_code ? Maps.canonical(map_code) : map_code_from_folder(path)

      rows.each_with_index do |row, row_index|
        command = row["command"]&.strip
        next if command.nil? || command.empty?

        reason = CommandValidator.skip_reason(command)
        if reason
          skipped_rows << SkippedRow.new(
            row_number: row_index + 2,
            reason: reason,
            command: command,
            description: row["description"].to_s.strip
          )
          next
        end

        index = spots.length + 1
        description = row["description"]&.strip
        normalized = CommandValidator.normalize(command)
        spots << Spot.new(
          index: index,
          command: normalized,
          description: description.nil? || description.empty? ? "Spot #{index}" : description,
          yaw: CommandValidator.yaw(normalized)
        )
      end

      new(File.basename(path, ".csv"), path, spots, skipped_rows, map_name)
    end

    def self.map_code_from_folder(path)
      folder = File.basename(File.dirname(path))
      Maps.valid_folder?(folder) ? Maps.canonical(folder) : nil
    end

    def initialize(name, path, spots, skipped_rows = [], map_name = nil)
      @name = name
      @path = path
      @spots = spots
      @skipped_rows = skipped_rows
      @map_code = Maps.canonical(map_name)
      @map_name = @map_code
    end

    def slug
      @slug ||= PlaylistAlias.scoped_slug(name, Maps.alias_map(map_code))
    end

    def command_alias
      @command_alias ||= PlaylistAlias.primary(name, Maps.alias_map(map_code))
    end
  end
end
