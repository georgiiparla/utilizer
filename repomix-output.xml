# frozen_string_literal: true

require "fileutils"

require_relative "playlist_file"
require_relative "maps"

class Utilizer
  class Playlists
    Entry = Struct.new(:map_code, :name, :filename, :path, keyword_init: true)

    def initialize(config)
      @config = config
    end

    def folder
      @config.data
      return @config.playlists_folder if @config.respond_to?(:playlists_folder)

      @config.data.fetch("playlists_folder")
    end

    def entries(map_code: nil)
      paths(map_code: map_code).map do |path|
        Entry.new(
          map_code: File.basename(File.dirname(path)),
          name: File.basename(path, ".csv"),
          filename: File.basename(path),
          path: path
        )
      end
    end

    def names(map_code: nil)
      entries(map_code: map_code).map(&:filename)
    end

    def all(map_code: nil)
      entries(map_code: map_code).map { |entry| PlaylistFile.load(entry.path, map_code: entry.map_code) }
    end

    def path_for(name, map_code: nil, must_exist: true)
      entry = entry_for(name, map_code: map_code, must_exist: must_exist)
      entry.path
    end

    def entry_for(name, map_code: nil, must_exist: true)
      filename = filename_for(name)
      if map_code
        code = Maps.validate_folder!(map_code)
        path = File.join(map_folder(code), filename)
        raise "Playlist not found: #{code}/#{filename}" if must_exist && !File.exist?(path)

        return Entry.new(map_code: code, name: File.basename(filename, ".csv"), filename: filename, path: path)
      end

      matches = entries.select { |entry| entry.filename.casecmp?(filename) }
      raise "Playlist not found: #{filename}" if matches.empty?

      if matches.length > 1
        maps = matches.map { |entry| entry.map_code }.join(", ")
        raise "Playlist name is ambiguous across maps: #{filename} (#{maps})"
      end

      matches.first
    end

    def unambiguous_entry(name)
      entry_for(name, must_exist: true)
    rescue StandardError
      nil
    end

    def map_folder(map_code)
      code = Maps.validate_folder!(map_code)
      path = File.join(folder, code)
      FileUtils.mkdir_p(path)
      path
    end

    private

    def filename_for(name)
      filename = name.to_s.strip
      raise "Missing playlist name" if filename.empty?
      raise "Playlist name must not include a folder path" if filename.include?("/") || filename.include?('\\')
      raise "Playlist name contains invalid filename characters" if filename.match?(/[<>:"|?*]/)

      filename += ".csv" unless filename.downcase.end_with?(".csv")
      raise "Playlist name cannot be empty" if filename == ".csv"

      filename
    end

    def paths(map_code: nil)
      codes = map_code ? [Maps.validate_folder!(map_code)] : Maps.folder_codes
      codes.flat_map do |code|
        map_path = map_folder(code)
        Dir.children(map_path)
           .select { |name| name.downcase.end_with?(".csv") }
           .map { |name| File.join(map_path, name) }
      end
           .sort_by { |path| natural_sort_key(File.basename(path, ".csv")) }
    end

    def natural_sort_key(name)
      key = name.scan(/\d+|\D+/).map do |part|
        if part.match?(/\A\d+\z/)
          [0, part.to_i, part.length]
        else
          [1, part.downcase]
        end
      end

      key << [2, name.downcase]
    end
  end
end
