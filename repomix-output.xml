# frozen_string_literal: true

require "fileutils"
require "json"
require "time"

require_relative "maps"
require_relative "path_normalizer"

class Utilizer
  class Config
    DIR = File.join(ENV.fetch("APPDATA", Dir.home), "Utilizer").tr('\\', "/")
    RUNTIME_DIR = File.join(DIR, "runtime")
    PATH = File.join(DIR, "config.json")

    KEYS = {
      "csgo" => "csgo_cfg_folder"
    }.freeze

    attr_reader :path

    def initialize(path = PATH)
      @path = path
      @mutex = Mutex.new
    end

    def data
      @mutex.synchronize do
        ensure_exists
        read
      end
    end

    def set(name, value)
      @mutex.synchronize do
        key = KEYS[name] || raise(ArgumentError, "Unknown config key: #{name}")
        ensure_exists
        values = read
        values[key] = key == "csgo_cfg_folder" ? normalize_csgo_cfg_folder(value) : value
        validate_csgo_cfg_folder!(values.fetch(key)) if key == "csgo_cfg_folder"
        write(values)
      end
    end

    def set_workspace(csgo_cfg_folder:, playlists_folder:)
      set_csgo_cfg_folder(csgo_cfg_folder)
    end

    def set_csgo_cfg_folder(value)
      @mutex.synchronize do
        ensure_exists
        values = read
        values["csgo_cfg_folder"] = normalize_csgo_cfg_folder(value)
        validate_csgo_cfg_folder!(values.fetch("csgo_cfg_folder"))
        write(values)
      end
    end

    def set_theme(value)
      @mutex.synchronize do
        ensure_exists
        values = read
        values["theme"] = value.to_s.strip
        write(values)
      end
    end

    def playlists_folder
      File.join(DIR, "playlists")
    end

    def web_registry_path
      File.join(RUNTIME_DIR, "web.json")
    end

    def web_log_path
      File.join(RUNTIME_DIR, "web.log")
    end

    def web_launch_lock_path
      File.join(RUNTIME_DIR, "web-launch.lock")
    end

    def web_server_lock_path
      File.join(RUNTIME_DIR, "web-server.lock")
    end

    def event_log_path
      File.join(RUNTIME_DIR, "utilizer.log")
    end

    def auth_token_path
      File.join(DIR, "auth_token.txt")
    end

    def auth_token
      @mutex.synchronize do
        ensure_exists
        token = read_auth_token
        return token if valid_auth_token?(token)

        require "securerandom"
        token = SecureRandom.hex(32)
        File.write(auth_token_path, "#{token}\n", encoding: "UTF-8")
        token
      end
    end

    def csgo_cfg_folder_warnings
      folder = data.fetch("csgo_cfg_folder")
      warnings = []
      return [not_configured_message] if folder.empty?

      warnings << "CS2 cfg folder path does not end with game/csgo/cfg." unless PathNormalizer.cs2_cfg_shape?(folder)
      warnings
    end

    private

    def read_auth_token
      File.read(auth_token_path, encoding: "UTF-8").strip
    rescue SystemCallError
      ""
    end

    def valid_auth_token?(value)
      value.to_s.match?(/\A[0-9a-f]{64}\z/)
    end

    def validate_csgo_cfg_folder!(csgo)
      folder = normalize_csgo_cfg_folder(csgo)
      raise not_configured_message if folder.empty?
      raise "CS2 cfg folder must end with game/csgo/cfg: #{folder}" unless PathNormalizer.cs2_cfg_shape?(folder)
      raise "CS2 cfg folder does not exist: #{folder}" unless Dir.exist?(folder)
      raise "CS2 cfg folder is not a folder: #{folder}" unless File.directory?(folder)
    rescue SystemCallError => e
      raise "CS2 cfg folder is not usable: #{e.message}"
    end

    def ensure_exists
      FileUtils.mkdir_p(DIR)
      migrate_flat_layout
      ensure_app_structure

      existing = File.exist?(@path) ? read : nil
      values = normalize(defaults.merge(existing || {}))
      ensure_playlist_structure
      write(values) if existing.nil? || values != existing
    end

    def defaults
      {
        "csgo_cfg_folder" => ""
      }
    end

    def read
      attempts = 0

      begin
        JSON.parse(File.read(@path))
      rescue JSON::ParserError
        repaired = repair_unescaped_csgo_path_json
        return repaired if repaired

        attempts += 1
        if attempts < 3
          sleep 0.02
          retry
        end

        raise "Configuration file is not valid JSON: #{@path}"
      end
    end

    def write(values)
      FileUtils.mkdir_p(File.dirname(@path))
      temp_path = "#{@path}.tmp-#{Process.pid}-#{Thread.current.object_id}"
      File.write(temp_path, "#{JSON.pretty_generate(normalize(values))}\n")
      File.rename(temp_path, @path)
    rescue SystemCallError
      raise unless File.exist?(temp_path)

      FileUtils.mv(temp_path, @path, force: true)
    ensure
      FileUtils.rm_f(temp_path) if temp_path && File.exist?(temp_path)
    end

    def normalize(values)
      normalized = {
        "csgo_cfg_folder" => normalize_csgo_cfg_folder(values.fetch("csgo_cfg_folder", ""))
      }
      normalized["theme"] = values["theme"].to_s.strip if values.key?("theme")
      normalized
    end

    def clean_path(path)
      PathNormalizer.normalize(path)
    end

    def normalize_csgo_cfg_folder(path)
      PathNormalizer.normalize_cs2_cfg(path)
    end

    def not_configured_message
      "CS2 cfg folder is not configured. Reinstall Utilizer or edit #{@path}."
    end

    def repair_unescaped_csgo_path_json
      text = File.read(@path, encoding: "UTF-8")
      match = text.match(/"csgo_cfg_folder"\s*:\s*"([^"]*)"/)
      return nil unless match

      values = {}
      values["csgo_cfg_folder"] = normalize_csgo_cfg_folder(match[1])
      theme = text[/"theme"\s*:\s*"([^"]*)"/, 1]
      values["theme"] = theme if theme
      write(values)
      append_config_warning("repaired config JSON with unescaped csgo_cfg_folder path")
      values
    rescue StandardError
      nil
    end

    def append_config_warning(message)
      FileUtils.mkdir_p(RUNTIME_DIR)
      File.open(event_log_path, "a", encoding: "UTF-8") do |file|
        file.puts("#{Time.now.utc.iso8601} config #{message}")
      end
    rescue StandardError
      nil
    end

    def ensure_playlist_structure
      FileUtils.mkdir_p(playlists_folder)
      Maps.folder_codes.each { |code| FileUtils.mkdir_p(File.join(playlists_folder, code)) }
    rescue SystemCallError => e
      raise "Playlists folder is not usable: #{e.message}"
    end

    def ensure_app_structure
      FileUtils.mkdir_p(RUNTIME_DIR)
    end

    def migrate_flat_layout
      migrate_file(File.join(DIR, "config", "config.json"), @path)
      migrate_file(File.join(DIR, "state", "web.json"), web_registry_path)
      migrate_file(File.join(DIR, "logs", "web.log"), web_log_path)
      migrate_file(File.join(DIR, "logs", "utilizer.log"), event_log_path)
      migrate_file(File.join(DIR, "locks", "web-launch.lock"), web_launch_lock_path)
      migrate_file(File.join(DIR, "locks", "web-server.lock"), web_server_lock_path)
      migrate_directory(File.join(DIR, "data", "playlists"), playlists_folder)
      remove_empty_legacy_directories
    end

    def migrate_file(source, destination)
      return unless File.file?(source)
      return if clean_path(source) == clean_path(destination)

      FileUtils.mkdir_p(File.dirname(destination))
      if File.exist?(destination)
        File.size?(source).nil? ? FileUtils.rm_f(source) : FileUtils.mv(source, legacy_path_for(destination))
        return
      end

      FileUtils.mv(source, destination)
    rescue Errno::EACCES, Errno::EPERM
      nil
    end

    def migrate_directory(source, destination)
      return unless Dir.exist?(source)
      return if clean_path(source) == clean_path(destination)

      FileUtils.mkdir_p(destination)
      Dir.children(source).each do |name|
        migrate_path(File.join(source, name), File.join(destination, name))
      end
      Dir.rmdir(source) if Dir.empty?(source)
    end

    def migrate_path(source, destination)
      if File.directory?(source)
        migrate_directory(source, destination)
        return
      end

      migrate_file(source, destination)
    end

    def legacy_path_for(destination)
      folder = File.dirname(destination)
      basename = File.basename(destination)
      candidate = File.join(folder, "legacy-#{basename}")
      return candidate unless File.exist?(candidate)

      index = 2
      loop do
        candidate = File.join(folder, "legacy-#{index}-#{basename}")
        return candidate unless File.exist?(candidate)

        index += 1
      end
    end

    def remove_empty_legacy_directories
      %w[config data locks logs state].each do |name|
        path = File.join(DIR, name)
        Dir.rmdir(path) if Dir.exist?(path) && Dir.empty?(path)
      rescue Errno::ENOTEMPTY, Errno::EACCES, Errno::EPERM
        nil
      end
    end
  end
end
