# frozen_string_literal: true

require "fileutils"
require "time"

class Utilizer
  class EventLog
    LEVELS = %w[INFO WARN ERROR].freeze

    attr_reader :path

    def initialize(path)
      @path = path
      @mutex = Mutex.new
      FileUtils.mkdir_p(File.dirname(@path))
    end

    def info(event, **attrs)
      record("INFO", event, attrs)
    end

    def warn(event, **attrs)
      record("WARN", event, attrs)
    end

    def error(event, **attrs)
      record("ERROR", event, attrs)
    end

    private

    def record(level, event, attrs)
      line = format_line(level, event, attrs)
      @mutex.synchronize do
        File.open(@path, "a", encoding: "UTF-8") { |file| file.puts(line) }
      end
    rescue StandardError
      nil
    end

    def format_line(level, event, attrs)
      timestamp = Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")
      payload = attrs.compact
                     .map { |key, value| "#{key}=#{format_value(value)}" }
                     .join(" ")
      payload.empty? ? "#{timestamp} #{level} #{event}" : "#{timestamp} #{level} #{event} #{payload}"
    end

    def format_value(value)
      str = value.to_s
      return %("") if str.empty?

      str.match?(/[\s"=\\]/) ? %("#{str.gsub("\\", "\\\\\\\\").gsub(%("), %(\\"))}") : str
    end
  end
end
