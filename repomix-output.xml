import { Controller } from "https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/+esm";
import { requestConfirm } from "../lib/confirm.js";
import { postFetch } from "../lib/http.js";
import { readJsonScript } from "../lib/json.js";
import { linkDisplayFor } from "../lib/links.js";
import { positionContextMenu } from "../lib/positioning.js";
import { clearSearchInput, matchesSearch, searchTerms } from "../lib/search.js";
import {
  playlistActionNoticeKey,
  playlistActionStorageKey,
  readLocalJson,
  readSessionJson,
  removeLocalItem,
  removeSessionItem,
  writeLocalJson,
  writeSessionJson,
} from "../lib/storage.js";

export default class extends Controller {
  static targets = [
    "form",
    "copySelectedButton",
    "deleteSelectedButton",
    "restoreSelectedButton",
    "selectionTools",
    "saveAction",
    "editorAlert",
    "rowCount",
    "acceptedCaptureInput",
    "playlistNameDisplay",
    "table",
    "serializedFields",
    "search",
    "contextMenu",
    "pageNotice",
    "notificationBar",
  ];
  static values = {
    mapCode: String,
    playlistName: String,
    playlistSlug: String,
  };

  connect() {
    if (!this.hasFormTarget || !this.hasTableTarget || !window.Tabulator) return;

    this.rowSequence = 0;
    this.storageKey = `utilizer:draft:${this.playlistName}`;
    this.allowFormSubmit = false;
    this.capturePollErrorShown = false;
    this.allowSelectionChange = false;
    this.selectedRowIds = new Set();
    this.serverRows = this.normalizeRows(readJsonScript("playlist-spots-data", []));
    this.initialTableData = this.rowsFromDraft();
    this.savedRowsByOriginalIndex = new Map(
      this.serverRows
        .filter((row) => row.originalIndex !== null)
        .map((row) => [row.originalIndex, this.rowSnapshot(row)]),
    );
    this.seenCaptureIds = new Set(
      this.initialTableData.map((row) => row.captureId).filter(Boolean),
    );
    this.playlistNameText = this.hasPlaylistNameDisplayTarget
      ? this.playlistNameDisplayTarget.textContent.trim()
      : this.playlistName;
    this.currentName = this.playlistNameText;
    this.renaming = false;

    this.boundDocumentClick = this.documentClick.bind(this);
    this.boundDocumentKeydown = this.documentKeydown.bind(this);
    this.boundCloseContextMenu = this.closeSpotContextMenu.bind(this);
    document.addEventListener("click", this.boundDocumentClick);
    document.addEventListener("keydown", this.boundDocumentKeydown);
    window.addEventListener("scroll", this.boundCloseContextMenu, true);
    window.addEventListener("resize", this.boundCloseContextMenu);

    this.showPlaylistActionNotice();
    this.initializeTable();
    this.applyFilter();
    this.updateSelectionTools();
    this.updateAcceptedCaptureIds();
    this.captureInterval = window.setInterval(() => this.pollLatestCapture(), 2000);
  }

  disconnect() {
    document.removeEventListener("click", this.boundDocumentClick);
    document.removeEventListener("keydown", this.boundDocumentKeydown);
    window.removeEventListener("scroll", this.boundCloseContextMenu, true);
    window.removeEventListener("resize", this.boundCloseContextMenu);
    if (this.captureInterval) window.clearInterval(this.captureInterval);
    if (this.table) this.table.destroy();
  }

  get playlistName() {
    return this.playlistNameValue || this.formTarget.dataset.playlistName || "";
  }

  get playlistSlug() {
    return this.playlistSlugValue || this.formTarget.dataset.playlistSlug || "";
  }

  get mapCode() {
    return this.mapCodeValue || this.formTarget.dataset.mapCode || "";
  }

  normalizeRows(rows) {
    return (Array.isArray(rows) ? rows : []).map((row) => {
      const originalIndex =
        row.originalIndex === null || row.originalIndex === undefined || row.originalIndex === ""
          ? null
          : Number(row.originalIndex);

      return {
        id: row.id || this.nextRowId(),
        originalIndex: Number.isFinite(originalIndex) ? originalIndex : null,
        description: String(row.description || ""),
        command: String(row.command || ""),
        link: String(row.link || ""),
        comment: String(row.comment || ""),
        captureId:
          row.captureId === null || row.captureId === undefined || row.captureId === ""
            ? null
            : String(row.captureId),
        deleted: row.deleted === true,
      };
    });
  }

  nextRowId(prefix = "new") {
    this.rowSequence += 1;
    return `${prefix}-${Date.now()}-${this.rowSequence}`;
  }

  rowSnapshot(row) {
    return {
      description: row.description || "",
      command: row.command || "",
      link: row.link || "",
      comment: row.comment || "",
    };
  }

  rowsFromDraft() {
    const draft = this.loadDraft();
    if (!Array.isArray(draft)) return this.serverRows;

    const rows = this.normalizeRows(draft);
    if (JSON.stringify(rows) === JSON.stringify(this.serverRows)) {
      this.clearDraft();
      return this.serverRows;
    }

    return rows;
  }

  initializeTable() {
    this.table = new Tabulator(this.tableTarget, {
      data: this.initialTableData,
      index: "id",
      height: "100%",
      layout: "fitColumns",
      resizableColumnFit: true,
      resizableColumnGuide: true,
      movableRows: true,
      selectableRows: true,
      selectableRowsRangeMode: "click",
      selectableRowsRollingSelection: false,
      rowHeader: {
        cssClass: "utilizer-selection-cell",
        formatter: (cell) => this.numberCell(cell),
        headerHozAlign: "center",
        headerSort: false,
        hozAlign: "center",
        minWidth: 64,
        resizable: false,
        rowHandle: true,
        width: 72,
        cellClick: (event, cell) => this.toggleRowSelection(event, cell.getRow()),
      },
      columnDefaults: {
        resizable: "header",
        vertAlign: "middle",
      },
      placeholder: "No spots yet. Right-click to add one.",
      columns: [
        {
          title: "Description",
          field: "description",
          cssClass: "utilizer-editable-cell",
          editor: (cell, onRendered, success, cancel, params) =>
            this.textareaEditor(cell, onRendered, success, cancel, params),
          editorParams: {
            selectContents: false,
            elementAttributes: { maxlength: "300" },
          },
          cellMouseDown: (event, cell) => this.rememberEditCaret(event, cell),
          formatter: "textarea",
          sorter: "string",
          minWidth: 260,
          variableHeight: true,
          widthGrow: 4,
          widthShrink: 2,
        },
        {
          title: "Command",
          field: "command",
          cssClass: "utilizer-editable-cell",
          editor: (cell, onRendered, success, cancel, params) =>
            this.textareaEditor(cell, onRendered, success, cancel, params),
          editorParams: {
            selectContents: false,
            elementAttributes: { maxlength: "2000" },
          },
          cellMouseDown: (event, cell) => this.rememberEditCaret(event, cell),
          formatter: (cell) => this.commandCell(cell),
          headerSort: false,
          minWidth: 220,
          variableHeight: true,
          widthGrow: 4,
          widthShrink: 1,
        },
        {
          title: "Comment",
          field: "comment",
          cssClass: "utilizer-editable-cell",
          editor: (cell, onRendered, success, cancel, params) =>
            this.textareaEditor(cell, onRendered, success, cancel, params),
          editorParams: {
            selectContents: false,
            elementAttributes: { maxlength: "500" },
          },
          cellMouseDown: (event, cell) => this.rememberEditCaret(event, cell),
          formatter: "textarea",
          headerSort: false,
          minWidth: 260,
          variableHeight: true,
          widthGrow: 4,
          widthShrink: 2,
        },
        {
          title: "Reference",
          field: "link",
          cssClass: "utilizer-editable-cell",
          editor: "input",
          editorParams: {
            selectContents: false,
            elementAttributes: { maxlength: "1000" },
          },
          formatter: (cell) => this.linkCell(cell),
          headerSort: false,
          minWidth: 200,
          widthGrow: 2,
          widthShrink: 1,
        },
      ],
      rowFormatter: (row) => this.formatRow(row),
    });

    this.table.on("cellEdited", () => this.afterTableChange());
    this.table.on("rowMoved", () => this.afterTableChange());
    this.table.on("rowClick", (event) => event.stopPropagation());
    this.table.on("rowSelectionChanged", (data, rows) => this.selectionChanged(rows));
    this.table.on("dataFiltered", () => this.refreshRows());
  }

  numberCell(cell) {
    const row = cell.getRow().getData();
    return row.deleted ? "x" : this.numberFor(row);
  }

  toggleRowSelection(event, row) {
    event.preventDefault();
    event.stopPropagation();
    if (!row) return;

    const id = row.getData().id;
    if (this.selectedRowIds.has(id)) {
      this.selectedRowIds.delete(id);
    } else {
      this.selectedRowIds.add(id);
    }

    this.applySelectedRowIds();
    this.updateSelectionTools();
  }

  applySelectedRowIds() {
    if (!this.table) return;

    this.allowSelectionChange = true;
    this.table.deselectRow();
    if (this.selectedRowIds.size > 0) {
      this.table.selectRow([...this.selectedRowIds]);
    }
    window.setTimeout(() => {
      this.allowSelectionChange = false;
    }, 0);
    this.updateSelectionTools();
  }

  selectionChanged(rows) {
    if (!this.allowSelectionChange) {
      this.applySelectedRowIds();
      return;
    }
    this.updateSelectionTools();
  }

  rememberEditCaret(event, cell) {
    const offset = this.caretOffsetFromPoint(event.clientX, event.clientY, cell.getElement());
    this.pendingEditCaret = {
      field: cell.getField(),
      rowId: cell.getRow().getData().id,
      offset,
    };
  }

  caretOffsetFromPoint(x, y, root) {
    const range =
      document.caretRangeFromPoint?.(x, y) ||
      (() => {
        const position = document.caretPositionFromPoint?.(x, y);
        if (!position) return null;

        const nextRange = document.createRange();
        nextRange.setStart(position.offsetNode, position.offset);
        return nextRange;
      })();

    if (!range || !root.contains(range.startContainer)) return null;

    const before = document.createRange();
    before.selectNodeContents(root);
    before.setEnd(range.startContainer, range.startOffset);
    return before.toString().length;
  }

  textareaEditor(cell, onRendered, success, cancel, params = {}) {
    const textarea = document.createElement("textarea");
    const attributes = params.elementAttributes || {};
    const value = String(cell.getValue() || "");

    textarea.value = value;
    textarea.spellcheck = false;
    Object.entries(attributes).forEach(([name, attributeValue]) => {
      textarea.setAttribute(name, attributeValue);
    });

    textarea.addEventListener("blur", () => success(textarea.value));
    textarea.addEventListener("input", () => this.resizeTextareaEditor(textarea, cell));
    textarea.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        cancel();
      }
    });

    onRendered(() => {
      textarea.focus({ preventScroll: true });
      const offset = this.pendingCaretFor(cell, value.length);
      textarea.setSelectionRange(offset, offset);
      this.resizeTextareaEditor(textarea, cell);
      this.pendingEditCaret = null;
    });

    return textarea;
  }

  resizeTextareaEditor(textarea, cell) {
    textarea.style.setProperty("height", "auto");
    textarea.style.setProperty("height", `${textarea.scrollHeight}px`, "important");
    window.requestAnimationFrame(() => cell.getRow().normalizeHeight?.());
  }

  pendingCaretFor(cell, fallback) {
    const pending = this.pendingEditCaret;
    const rowId = cell.getRow().getData().id;
    if (!pending || pending.field !== cell.getField() || pending.rowId !== rowId) return fallback;
    if (!Number.isFinite(pending.offset)) return fallback;

    return Math.max(0, Math.min(fallback, pending.offset));
  }

  commandCell(cell) {
    const value = String(cell.getValue() || "").trim();
    if (!value) return "";

    const badge = document.createElement("span");
    const label = document.createElement("span");

    badge.className = "utilizer-command-badge inline-flex";
    badge.title = value;
    label.className = "truncate";
    label.textContent = this.commandSummary(value);
    badge.append(label);
    return badge;
  }

  commandSummary(value) {
    const numbers = value.match(/-?\d+(?:\.\d+)?/g) || [];
    if (numbers.length >= 5) {
      const rounded = numbers.map((number) => this.roundCommandNumber(number));
      const position = rounded.slice(0, 3).join(" ");
      const angle = rounded.slice(3, 6).join(" ");
      return `${position} | ${angle}`;
    }

    return value.replace(/\s+/g, " ");
  }

  roundCommandNumber(value) {
    const number = Number(value);
    if (!Number.isFinite(number)) return value;

    return String(Math.round(number * 100) / 100);
  }

  linkCell(cell) {
    const value = String(cell.getValue() || "").trim();
    if (!value) return "";

    const { display, href } = linkDisplayFor(value);
    const link = document.createElement("a");
    const icon = document.createElement("i");
    const label = document.createElement("span");

    link.href = href;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    link.className = "utilizer-link-badge inline-flex";
    link.title = value;
    icon.className = "ph-bold ph-arrow-square-out text-[10px] opacity-60";
    label.className = "truncate";
    label.textContent = display || "Link";
    link.append(icon, label);
    return link;
  }

  formatRow(row) {
    const data = row.getData();
    const element = row.getElement();

    element.dataset.rowId = data.id;
    element.classList.toggle("utilizer-tabulator-row-deleted", data.deleted);
    element.classList.toggle("utilizer-tabulator-row-unsaved", this.rowHasUnsavedState(data));
  }

  displayRows() {
    return this.table ? this.table.getData() : this.initialTableData;
  }

  activeRows() {
    return this.displayRows().filter((row) => !row.deleted);
  }

  naturalRows() {
    return this.activeRows().slice().reverse();
  }

  numberFor(row) {
    return this.naturalRows().findIndex((candidate) => candidate.id === row.id) + 1;
  }

  rowHasUnsavedState(row) {
    if (row.originalIndex === null) return true;
    if (row.deleted) return true;

    const saved = this.savedRowsByOriginalIndex.get(row.originalIndex);
    if (!saved) return true;

    const currentIndex = this.naturalRows().findIndex((candidate) => candidate.id === row.id);
    return (
      currentIndex !== row.originalIndex ||
      row.description !== saved.description ||
      row.command !== saved.command ||
      row.link !== saved.link ||
      row.comment !== saved.comment
    );
  }

  refreshRows() {
    this.table?.getRows().forEach((row) => {
      this.formatRow(row);
      row.reformat?.();
    });
    this.updateAcceptedCaptureIds();
    this.updateSelectionTools();
  }

  afterTableChange({ persist = true } = {}) {
    this.refreshRows();
    this.applyFilter();
    if (persist) this.persistDraft();
  }

  persistDraft() {
    writeLocalJson(this.storageKey, this.displayRows());
  }

  clearDraft() {
    removeLocalItem(this.storageKey);
  }

  loadDraft() {
    return readLocalJson(this.storageKey, null);
  }

  applyFilter() {
    if (!this.table) return;

    const terms = searchTerms(this.hasSearchTarget ? this.searchTarget.value : "");
    if (terms.length === 0) {
      this.table.clearFilter(true);
      return;
    }

    this.table.setFilter((data) =>
      matchesSearch(
        [data.description, data.command, data.comment, data.link].join(" "),
        terms,
      ),
    );
  }

  clearSearch(event) {
    if (event.key !== "Escape" || !clearSearchInput(this.searchTarget)) return;

    event.preventDefault();
    this.applyFilter();
  }

  selectedRows() {
    if (!this.table?.getRows) return [];

    return this.table
      .getRows()
      .filter((row) => this.selectedRowIds.has(row.getData().id));
  }

  selectedActiveRows() {
    return this.selectedRows().filter((row) => !row.getData().deleted);
  }

  selectedDeletedRows() {
    return this.selectedRows().filter((row) => row.getData().deleted);
  }

  updateSelectionTools() {
    const selectedRows = this.selectedRows();
    const activeCount = selectedRows.filter((row) => !row.getData().deleted).length;
    const deletedCount = selectedRows.length - activeCount;
    const selectedCount = selectedRows.length;
    const hasSelection = selectedCount > 0;

    this.selectionToolsTargets.forEach((tools) => {
      tools.classList.toggle("hidden", !hasSelection);
      tools.classList.toggle("inline-flex", hasSelection);
    });

    this.selectionToolsTargets.filter((tools) => tools.matches("[data-selection-copy-tools]")).forEach((tools) => {
      const visible = activeCount > 0;
      tools.classList.toggle("hidden", !visible);
      tools.classList.toggle("inline-flex", visible);
    });

    this.selectionToolsTargets.filter((tools) => tools.matches("[data-selection-delete-tools]")).forEach((tools) => {
      const visible = activeCount > 0;
      tools.classList.toggle("hidden", !visible);
      tools.classList.toggle("inline-flex", visible);
    });

    this.selectionToolsTargets.filter((tools) => tools.matches("[data-selection-restore-tools]")).forEach((tools) => {
      const visible = deletedCount > 0;
      tools.classList.toggle("hidden", !visible);
      tools.classList.toggle("inline-flex", visible);
    });

    if (this.hasCopySelectedButtonTarget) {
      this.copySelectedButtonTarget.textContent = activeCount > 1 ? `COPY ${activeCount}` : "COPY";
    }
    if (this.hasDeleteSelectedButtonTarget) {
      this.deleteSelectedButtonTarget.textContent =
        activeCount > 1 ? `DELETE ${activeCount}` : "DELETE";
    }
    if (this.hasRestoreSelectedButtonTarget) {
      this.restoreSelectedButtonTarget.textContent =
        deletedCount > 1 ? `RESTORE ${deletedCount}` : "RESTORE";
    }
  }

  clearSelectedSpots() {
    this.selectedRowIds.clear();
    this.table?.deselectRow?.();
    this.updateSelectionTools();
  }

  showEditorAlert(message, type = "info") {
    if (this.hasPageNoticeTarget) this.pageNoticeTarget.classList.add("hidden");
    if (!this.hasEditorAlertTarget) return;

    this.editorAlertTarget.textContent = message;
    this.editorAlertTarget.className = `text-lg font-mono text-${type}`;
    this.editorAlertTarget.classList.remove("hidden");
    if (this.hasNotificationBarTarget) this.notificationBarTarget.classList.remove("hidden");
  }

  showPlaylistActionNotice() {
    const playlistActionNotice = readSessionJson(playlistActionNoticeKey);
    if (!playlistActionNotice) return;

    removeSessionItem(playlistActionNoticeKey);
    if (playlistActionNotice.linkUrl && playlistActionNotice.linkText && this.hasEditorAlertTarget) {
      if (this.hasPageNoticeTarget) this.pageNoticeTarget.classList.add("hidden");
      this.editorAlertTarget.textContent = "";
      this.editorAlertTarget.className = `text-lg font-mono text-${playlistActionNotice.type || "success"}`;
      const prefix = document.createTextNode("Copied to ");
      const link = document.createElement("a");
      link.href = playlistActionNotice.linkUrl;
      link.className = "underline underline-offset-2";
      link.textContent = playlistActionNotice.linkText;
      this.editorAlertTarget.append(prefix, link, document.createTextNode("."));
      this.editorAlertTarget.classList.remove("hidden");
      if (this.hasNotificationBarTarget) this.notificationBarTarget.classList.remove("hidden");
    } else {
      this.showEditorAlert(playlistActionNotice.message, playlistActionNotice.type || "success");
    }
  }

  blankSpot({ description = "", command = "", link = "", comment = "", captureId = null } = {}) {
    return {
      id: this.nextRowId(),
      originalIndex: null,
      description,
      command,
      link,
      comment,
      captureId: captureId ? String(captureId) : null,
      deleted: false,
    };
  }

  addNewSpot() {
    if (this.hasSearchTarget && clearSearchInput(this.searchTarget)) this.applyFilter();

    const spot = this.blankSpot();
    Promise.resolve(this.table.addData([spot], true)).then(() => {
      this.afterTableChange();
      const row = this.safeGetRow(spot.id);
      row?.getCell("description")?.edit();
    });
  }

  clearServerCapture(id) {
    if (!id) return;

    postFetch("/captures/clear", { id }, { keepalive: true }).catch(() => {});
  }

  applyLatestCaptures(captures) {
    const spots = [];

    captures.forEach((capture) => {
      if (!capture || !capture.id || !capture.command) return;

      const id = String(capture.id);
      if (this.seenCaptureIds.has(id)) return;
      if (this.displayRows().some((row) => String(row.captureId) === id)) {
        this.seenCaptureIds.add(id);
        return;
      }

      this.seenCaptureIds.add(id);
      spots.push(
        this.blankSpot({
          description: capture.description || "",
          command: capture.command,
          captureId: id,
        }),
      );
    });

    if (spots.length === 0) return;

    Promise.resolve(this.table.addData(spots, true)).then(() => {
      this.afterTableChange();
      this.showEditorAlert(
        spots.length === 1
          ? "Captured latest spot. Add a description, then Save."
          : `Captured ${spots.length} spots. Add descriptions, then Save.`,
        "success",
      );
    });
  }

  async pollLatestCapture() {
    try {
      const query = this.playlistSlug
        ? `?${new URLSearchParams({ playlist: this.playlistSlug })}`
        : "";
      const response = await fetch(`/captures/latest${query}`);
      const data = await response.json();
      if (!data.ok) {
        if (!this.capturePollErrorShown) {
          this.showEditorAlert(data.message || "Capture polling failed.", "error");
        }
        this.capturePollErrorShown = true;
        return;
      }

      this.capturePollErrorShown = false;
      this.applyLatestCaptures(data.captures || (data.capture ? [data.capture] : []));
    } catch (e) {
      if (!this.capturePollErrorShown) this.showEditorAlert("Capture polling failed.", "error");
      this.capturePollErrorShown = true;
    }
  }

  updateAcceptedCaptureIds() {
    if (!this.hasAcceptedCaptureInputTarget) return;

    this.acceptedCaptureInputTarget.value = this.naturalRows()
      .map((row) => row.captureId)
      .filter(Boolean)
      .join(",");
  }

  appendSerializedField(name, value) {
    const input = document.createElement("input");
    input.type = "hidden";
    input.name = name;
    input.value = value == null ? "" : String(value);
    this.serializedFieldsTarget.appendChild(input);
  }

  serializeForm(action = "") {
    const rows = this.naturalRows();

    this.serializedFieldsTarget.replaceChildren();
    if (this.hasSaveActionTarget) this.saveActionTarget.value = action;
    if (this.hasRowCountTarget) this.rowCountTarget.value = rows.length;
    this.updateAcceptedCaptureIds();

    rows.forEach((row, index) => {
      this.appendSerializedField(`description_${index}`, row.description);
      this.appendSerializedField(`command_${index}`, row.command);
      this.appendSerializedField(`link_${index}`, row.link);
      this.appendSerializedField(`comment_${index}`, row.comment);
    });
  }

  submitPlaylistForm(action = "") {
    this.allowFormSubmit = true;
    this.serializeForm(action);
    this.clearDraft();
    this.formTarget.requestSubmit();
  }

  resetOrder() {
    this.clearSelectedSpots();
    const rows = this.displayRows();
    const savedRows = rows
      .filter((row) => row.originalIndex !== null)
      .sort((a, b) => b.originalIndex - a.originalIndex);
    const addedRows = rows.filter((row) => row.originalIndex === null);

    Promise.resolve(this.table.setData([...addedRows, ...savedRows])).then(() => {
      this.afterTableChange();
    });
  }

  requestResetOrder() {
    requestConfirm({
      title: "Reset order?",
      body: "Restore rows to the saved CSV order. Field edits stay as they are.",
      actionLabel: "Reset order",
      actionClass: "btn-neutral",
      onConfirm: () => this.resetOrder(),
    });
  }

  requestSync() {
    this.serializeForm("sync");
    requestConfirm({
      title: "Save and sync this playlist?",
      body: "Write the current playlist CSV, then generate CS2 cfg files for this playlist.",
      actionLabel: "Save + Sync",
      actionClass: "btn-success",
      onConfirm: () => this.submitPlaylistForm("sync"),
    });
  }

  startPlaylistTargetSelection(action) {
    this.persistDraft();
    writeSessionJson(playlistActionStorageKey, {
      ...action,
      mapCode: this.mapCode,
      sourceName: this.formTarget.dataset.playlistName,
      returnUrl: window.location.pathname,
    });
    window.location.href = `/maps/${encodeURIComponent(this.mapCode)}`;
  }

  requestCopySelectedSpots() {
    const selected = this.selectedActiveRows().map((row) => row.getData());
    if (selected.length === 0) return;

    const payloads = selected.map((row) => ({
      description: row.description || "",
      command: row.command || "",
      link: row.link || "",
    }));
    const emptyCommands = payloads.filter((payload) => payload.command.trim() === "");
    if (emptyCommands.length > 0) {
      this.showEditorAlert("Cannot copy selected spots with empty commands.", "error");
      return;
    }

    this.startPlaylistTargetSelection({
      type: "copy",
      spots: payloads,
    });
  }

  rowIsEffectivelyBlank(row) {
    return [row.description, row.command, row.link].every((value) => String(value || "").trim() === "");
  }

  deleteSpotRow(row) {
    if (!row) return Promise.resolve();

    const data = row.getData();
    this.selectedRowIds.delete(data.id);
    if (data.originalIndex === null || this.rowIsEffectivelyBlank(data)) {
      if (data.captureId) this.clearServerCapture(data.captureId);
      return Promise.resolve(row.delete());
    }

    return Promise.resolve(row.update({ deleted: true })).then(() => row.deselect?.());
  }

  requestDeleteSelectedSpots() {
    const selected = this.selectedActiveRows();
    if (selected.length === 0) return;

    requestConfirm({
      title:
        selected.length === 1
          ? "Delete selected spot?"
          : `Delete ${selected.length} selected spots?`,
      body: "Remove the selected spots from this playlist.",
      actionLabel: "Delete",
      actionClass: "btn-error",
      onConfirm: () => {
        Promise.all(selected.map((row) => this.deleteSpotRow(row))).then(() => {
          this.clearSelectedSpots();
          this.afterTableChange();
          this.showEditorAlert(
            selected.length === 1 ? "Selected spot removed." : "Selected spots removed.",
            "info",
          );
        });
      },
    });
  }

  restoreSelectedSpots() {
    const selected = this.selectedDeletedRows();
    if (selected.length === 0) return;

    Promise.all(selected.map((row) => row.update({ deleted: false }))).then(() => {
      selected.forEach((row) => this.selectedRowIds.delete(row.getData().id));
      this.applySelectedRowIds();
      this.table?.redraw?.(true);
      selected.forEach((row) => row.normalizeHeight?.());
      this.afterTableChange();
      this.showEditorAlert(
        selected.length === 1 ? "Selected spot restored." : "Selected spots restored.",
        "info",
      );
    });
  }

  safeGetRow(id) {
    const row = this.table?.getRow(id);
    return row || null;
  }

  closeSpotContextMenu() {
    if (!this.hasContextMenuTarget) return;

    this.contextMenuTarget.classList.add("hidden");
    this.contextMenuTarget.setAttribute("aria-hidden", "true");
  }

  showSpotContextMenu(event) {
    if (!this.hasContextMenuTarget || !window.FloatingUIDOM) return;

    event.preventDefault();
    this.contextMenuTarget.querySelectorAll("[data-spot-menu-action]").forEach((button) => {
      const action = button.dataset.spotMenuAction;
      const visible = action === "new" || action === "reset-order";
      button.classList.toggle("hidden", !visible);
      button.classList.toggle("flex", visible);
    });
    this.contextMenuTarget.classList.remove("hidden");
    this.contextMenuTarget.setAttribute("aria-hidden", "false");
    positionContextMenu(this.contextMenuTarget, event);
  }

  runSpotContextAction(event) {
    const button = event.target.closest("[data-spot-menu-action]");
    if (!button) return;

    event.preventDefault();
    event.stopPropagation();
    const action = button.dataset.spotMenuAction;
    this.closeSpotContextMenu();

    if (action === "new") {
      this.addNewSpot();
    } else if (action === "reset-order") {
      this.requestResetOrder();
    }
  }

  documentClick(event) {
    if (this.hasContextMenuTarget && !this.contextMenuTarget.contains(event.target)) {
      this.closeSpotContextMenu();
    }
  }

  documentKeydown(event) {
    if (event.key === "Escape") this.closeSpotContextMenu();
  }

  startRename() {
    if (this.renaming || !this.hasPlaylistNameDisplayTarget) return;

    this.renaming = true;
    this.playlistNameDisplayTarget.contentEditable = "plaintext-only";
    this.playlistNameDisplayTarget.classList.add("utilizer-inline-editing");
    this.playlistNameDisplayTarget.focus();
    document.getSelection()?.selectAllChildren(this.playlistNameDisplayTarget);
  }

  beginRename() {
    if (!this.hasPlaylistNameDisplayTarget || this.playlistNameDisplayTarget.isContentEditable) return;

    this.updatePlaylistNameDisplay();
    this.startRename();
  }

  updatePlaylistNameDisplay() {
    if (this.hasPlaylistNameDisplayTarget) {
      this.playlistNameDisplayTarget.textContent = this.playlistNameText;
    }
  }

  stopRename() {
    if (!this.hasPlaylistNameDisplayTarget) return;

    this.renaming = false;
    this.playlistNameDisplayTarget.contentEditable = "false";
    this.playlistNameDisplayTarget.classList.remove("utilizer-inline-editing");
  }

  cancelRename() {
    this.updatePlaylistNameDisplay();
    this.stopRename();
  }

  async submitRename() {
    if (!this.hasPlaylistNameDisplayTarget) return;

    const nextName = this.playlistNameDisplayTarget.textContent.trim();
    if (!nextName || nextName === this.currentName) {
      this.cancelRename();
      return;
    }

    if (nextName.includes("/") || nextName.includes("\\")) {
      alert("Playlist name cannot contain slashes.");
      this.cancelRename();
      return;
    }
    if (/[<>:"|?*]/.test(nextName)) {
      alert('Playlist name cannot contain special characters (< > : " | ? *).');
      this.cancelRename();
      return;
    }

    this.stopRename();
    const previousName = this.currentName;
    this.playlistNameText = nextName;
    this.currentName = nextName;
    try {
      const response = await postFetch(`${this.formTarget.action}/rename`, {
        playlist_name: nextName,
      });
      const data = await response.json();
      if (!data.ok) {
        this.playlistNameText = previousName;
        this.currentName = previousName;
        this.updatePlaylistNameDisplay();
        this.showEditorAlert(data.message || "Rename failed.", "error");
        return;
      }
      window.location.href = data.redirect || this.formTarget.action;
    } catch (e) {
      this.playlistNameText = previousName;
      this.currentName = previousName;
      this.updatePlaylistNameDisplay();
      this.showEditorAlert("Rename failed.", "error");
    }
  }

  renameKeydown(event) {
    if (!this.renaming) return;

    if (event.key === "Enter") {
      event.preventDefault();
      this.playlistNameDisplayTarget.blur();
    } else if (event.key === "Escape") {
      event.preventDefault();
      this.cancelRename();
    }
  }

  renameBlur() {
    if (this.renaming) this.submitRename();
  }

  submitForm(event) {
    this.serializeForm();
    if (this.allowFormSubmit) {
      this.clearDraft();
      return;
    }

    event.preventDefault();
    this.requestSync();
  }
}
