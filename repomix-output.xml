<file path="utilizer-ruby/lib/utilizer/web/assets/controllers/theme_controller.js">
import { Controller } from "https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/+esm";
import { postFetch } from "../lib/http.js";

export default class extends Controller {
  static targets = ["switcher", "choice"];

  connect() {
    this.root = document.documentElement;
    this.storageKey = "utilizer:theme";
    this.themes = (this.root.dataset.themeOptions || "").split(",").filter(Boolean);
    this.fallback = this.root.dataset.defaultTheme || "business";
    this.applyTheme(this.root.dataset.theme, false);
  }

  choose(event) {
    this.applyTheme(event.currentTarget.dataset.themeChoice);
    this.switcherTargets.forEach((switcher) => {
      switcher.open = false;
    });
  }

  normalizeTheme(theme) {
    return this.themes.includes(theme) ? theme : this.fallback;
  }

  markTheme(theme) {
    this.choiceTargets.forEach((button) => {
      button.setAttribute(
        "aria-current",
        button.dataset.themeChoice === theme ? "true" : "false",
      );
    });
  }

  applyTheme(theme, persist = true) {
    const nextTheme = this.normalizeTheme(theme);
    this.root.dataset.theme = nextTheme;
    this.markTheme(nextTheme);

    if (!persist) return;

    try {
      localStorage.setItem(this.storageKey, nextTheme);
    } catch (e) {}

    postFetch("/theme", { theme: nextTheme }, { keepalive: true }).catch(() => {});
  }
}
</file>

