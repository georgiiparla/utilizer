# frozen_string_literal: true

require "fileutils"
require "json"
require "time"

require_relative "capture_protocol"
require_relative "maps"
require_relative "path_normalizer"
require_relative "playlist_alias"
require_relative "runtime_gates"

class Utilizer
  class CfgSync
    Result = Struct.new(
      :playlist_count,
      :spot_count,
      :skipped_row_count,
      :skipped_reasons,
      :target_folder,
      :warnings,
      :generation_id,
      :elapsed_seconds,
      keyword_init: true
    )

    GENERATED_HEADER = "// Generated by Utilizer. Do not edit."
    MANIFEST_FILE = "manifest.json"
    MANIFEST_VERSION = 2
    RUNTIME_OWNER = "runtime"
    SV_CHEATS_LINE = "sv_cheats 1"
    ARROW_ACTIONS = RuntimeGates::ACTIONS
    SPOT_SHORTCUT_PREFIX = "ut_"
    RESERVED_ALIASES = (["ut_save"] + RuntimeGates.aliases).freeze

    def initialize(config, playlists)
      @config = config
      @playlists = playlists
      reset_generation_tracking
    end

    def run(scope: nil, map_code: nil, map_codes: [], playlist_name: nil)
      started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      @csgo_cfg_folder = configured_cfg_folder

      playlists = @playlists.all

      @generation_id = Time.now.utc.strftime("%Y%m%d%H%M%S")
      @warnings = cfg_folder_warnings
      requested_scope = sync_scope(scope, playlist_name)
      synced_playlists = case requested_scope
                         when "all"
                           validate_playlists(playlists)
                           sync_all(playlists)
                         when "maps"
                           sync_maps(playlists, map_codes)
                         when "map"
                           sync_map(playlists, Maps.validate_folder!(map_code))
                         when "playlist"
                           sync_playlist(playlists, playlist_name, map_code: map_code)
                         else
                           raise "Unknown sync scope: #{requested_scope}"
                         end

      Result.new(
        playlist_count: synced_playlists.length,
        spot_count: synced_playlists.sum { |playlist| playlist.spots.length },
        skipped_row_count: synced_playlists.sum { |playlist| playlist.skipped_rows.length },
        skipped_reasons: skipped_reasons(synced_playlists),
        target_folder: @csgo_cfg_folder,
        warnings: @warnings,
        generation_id: @generation_id,
        elapsed_seconds: Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at
      )
    end

    private

    def configured_cfg_folder
      folder = PathNormalizer.normalize_cs2_cfg(@config.data["csgo_cfg_folder"])
      raise not_configured_message if folder.empty?
      raise "CS2 cfg folder must end with game/csgo/cfg: #{folder}" unless PathNormalizer.cs2_cfg_shape?(folder)
      raise "CS2 cfg folder not found: #{folder}" unless Dir.exist?(folder)
      raise "CS2 cfg folder is not a folder: #{folder}" unless File.directory?(folder)

      folder
    rescue SystemCallError => e
      raise "CS2 cfg folder is not usable: #{e.message}"
    end

    def not_configured_message
      path = @config.respond_to?(:path) ? @config.path : "config.json"
      "CS2 cfg folder is not configured. Reinstall Utilizer or edit #{path}."
    end

    def sync_all(playlists)
      reset_generation_tracking
      set_spot_shortcut_count(playlists)
      cleanup_previous_output
      write_capture_cfg
      write_runtime_gate_files
      playlists.each { |playlist| write_playlist(playlist) }
      write_manifest(playlists: playlists)
      playlists
    end

    def sync_maps(playlists, map_codes)
      selected_map_codes = map_codes.map { |code| Maps.validate_folder!(code) }.uniq
      manifest = read_existing_manifest
      scoped = playlists.select { |playlist| selected_map_codes.include?(playlist.map_code) }
      removed_owner_slugs = manifest_playlist_owner_slugs(manifest)

      validate_playlists(scoped)
      reset_generation_tracking
      set_spot_shortcut_count(scoped)
      remove_owner_output(manifest, removed_owner_slugs)
      write_capture_cfg
      write_runtime_gate_files
      scoped.each { |playlist| write_playlist(playlist) }
      write_manifest(playlists: scoped, previous_manifest: manifest, removed_owner_slugs: removed_owner_slugs)
      scoped
    end

    def sync_map(playlists, map_code)
      manifest = read_existing_manifest
      scoped = playlists.select { |playlist| playlist.map_code == map_code }
      removed_owner_slugs = map_manifest_owner_slugs(manifest, map_code)

      validate_playlists(scoped)
      reset_generation_tracking
      set_spot_shortcut_count(scoped)
      remove_owner_output(manifest, removed_owner_slugs)
      write_capture_cfg
      write_runtime_gate_files
      scoped.each { |playlist| write_playlist(playlist) }
      write_manifest(playlists: scoped, previous_manifest: manifest, removed_owner_slugs: removed_owner_slugs)
      scoped
    end

    def sync_playlist(playlists, playlist_name, map_code: nil)
      playlist = find_playlist(playlists, playlist_name, map_code: map_code)
      manifest = read_existing_manifest

      validate_playlists([playlist])
      reset_generation_tracking
      set_spot_shortcut_count([playlist])
      remove_playlist_output(manifest, playlist)
      write_capture_cfg
      write_runtime_gate_files
      write_playlist(playlist)
      write_manifest(playlists: [playlist], previous_manifest: manifest, removed_owner_slugs: [playlist.slug])
      [playlist]
    end

    def sync_scope(scope, playlist_name)
      value = scope.to_s.strip
      return value unless value.empty?

      playlist_name.to_s.strip.empty? ? "all" : "playlist"
    end

    def find_playlist(playlists, playlist_name, map_code: nil)
      name = playlist_name.to_s.delete_suffix(".csv")
      candidates = playlists.select { |candidate| candidate.name == name }
      candidates = candidates.select { |candidate| candidate.map_code == Maps.validate_folder!(map_code) } if map_code
      raise "Playlist not found: #{playlist_name}" if candidates.empty?

      if candidates.length > 1
        maps = candidates.map(&:map_code).join(", ")
        raise "Playlist name is ambiguous across maps: #{playlist_name} (#{maps})"
      end

      candidates.first
    end

    def reset_generation_tracking
      @generated_files = []
      @playlist_files = Hash.new { |files, slug| files[slug] = [] }
      @spot_shortcut_count = 0
    end

    def set_spot_shortcut_count(playlists)
      @spot_shortcut_count = playlists.map { |playlist| playlist.spots.length }.max.to_i
    end

    def validate_playlists(playlists)
      empty = playlists.select { |playlist| playlist.slug.empty? }.map(&:name)
      raise "Playlist name cannot be used as a cfg command: #{empty.join(", ")}" if empty.any?

      duplicates = playlists.group_by(&:slug).select { |_, grouped| grouped.length > 1 }
      unless duplicates.empty?
        names = duplicates.values.flatten.map(&:name).join(", ")
        raise "Playlist names collide after sanitizing: #{names}"
      end

      reserved = playlists.select { |playlist| RESERVED_ALIASES.include?(playlist.command_alias) }
      unless reserved.empty?
        names = reserved.map(&:name).join(", ")
        raise "Playlist command is reserved for Utilizer capture: #{names}"
      end

      alias_pairs = playlists.map { |playlist| [playlist.command_alias, playlist] }
      alias_duplicates = alias_pairs.group_by(&:first).select { |_, grouped| grouped.length > 1 }
      return if alias_duplicates.empty?

      names = alias_duplicates.values.flatten.map { |_, playlist| playlist.name }.join(", ")
      raise "Playlist commands collide after shortening: #{names}"
    end

    def cleanup_previous_output
      cleanup_manifest_files
      remove_generated_tree(legacy_generated_folder)
      remove_generated_tree(helper_root)
      remove_generated_tree(runtime_root)
      remove_legacy_runtime_files
    end

    def cleanup_manifest_files
      files = read_manifest.fetch("files", [])
      files.each { |relative_path| remove_manifest_file(relative_path) }
      FileUtils.rm_f(manifest_path)
    end

    def read_manifest
      read_existing_manifest || { "files" => [] }
    end

    def read_existing_manifest
      return nil unless File.exist?(manifest_path)

      JSON.parse(File.read(manifest_path, encoding: "UTF-8"))
    rescue JSON::ParserError, SystemCallError
      nil
    end

    def remove_playlist_output(manifest, playlist)
      return unless manifest

      playlist_manifest_files(manifest, playlist).each { |relative_path| remove_manifest_file(relative_path) }
    end

    def remove_owner_output(manifest, owner_slugs)
      return unless manifest

      owner_slugs.each do |slug|
        playlist_manifest_files_for_slug(manifest, slug).each { |relative_path| remove_manifest_file(relative_path) }
      end
    end

    def remove_manifest_file(relative_path)
      path = File.expand_path(relative_path.to_s, @csgo_cfg_folder)
      assert_inside_cfg!(path)
      return unless File.file?(path)
      return unless generated_file?(path)

      FileUtils.rm_f(path)
    end

    def remove_generated_tree(path)
      target = clean_path(File.expand_path(path))
      root = clean_path(File.expand_path(console_folder))
      raise "Refusing to remove unexpected generated folder: #{target}" unless target.start_with?("#{root}/")

      FileUtils.rm_rf(path)
    end

    def remove_legacy_runtime_files
      legacy_names = %w[start main stop controls]
      legacy_names.each do |name|
        remove_legacy_file(File.join(console_folder, "#{name}.cfg"))
      end

      remove_legacy_file(File.join(@csgo_cfg_folder, "autoutilizer.cfg"))
    end

    def remove_legacy_file(path)
      return unless File.file?(path)

      content = File.binread(path).encode("UTF-8", invalid: :replace, undef: :replace, replace: "")
      old_runtime = content.include?("console_utilizer/generated") ||
                    content.include?("console_utilizer/controls") ||
                    content.include?("ut_loop") ||
                    content.include?("ut_on") ||
                    content.include?("ut_off")
      FileUtils.rm_f(path) if old_runtime
    rescue SystemCallError
      nil
    end

    def write_capture_cfg
      write_cfg(root_cfg_file("ut_save"), [
                  SV_CHEATS_LINE,
                  echoln(CaptureProtocol::CAPTURE_MARKER),
                  "getpos"
                ])
    end

    def write_runtime_gate_files
      ARROW_ACTIONS.each_value do |action|
        write_cfg(runtime_gate_file(action), [action.fetch(:alias)])
      end
    end

    def write_playlist(playlist)
      first = playlist.spots.first
      last = playlist.spots.last
      lines = [SV_CHEATS_LINE, "clear", playlist_marker(playlist), capture_alias_line]

      if first
        lines.push(
          *spot_shortcut_lines(playlist),
          *arrow_runtime_lines({
                                 "right" => exec_spot(playlist, first),
                                 "left" => exec_spot(playlist, last),
                                 "up" => exec_spot(playlist, first),
                                 "down" => "setang 89 #{first.yaw} 0"
                               }),
          echo("#{playlist.name}: #{playlist.spots.length} spots loaded")
        )
      else
        lines.push(
          *spot_shortcut_lines(playlist),
          *arrow_runtime_lines(empty_playlist_actions(playlist)),
          echo("#{playlist.name}: no valid spots")
        )
      end

      write_cfg(root_cfg_file(playlist.command_alias), lines, owner: playlist.slug)
      playlist.spots.each { |spot| write_spot(playlist, spot) }
    end

    def write_spot(playlist, spot)
      next_spot = playlist.spots[spot.index] || playlist.spots.first
      prev_spot = playlist.spots[spot.index - 2] || playlist.spots.last

      write_cfg(spot_cfg_file(playlist, spot), [
                  SV_CHEATS_LINE,
                  "clear",
                  playlist_marker(playlist),
                  capture_alias_line,
                  *arrow_runtime_lines({
                                         "right" => exec_spot(playlist, next_spot),
                                         "left" => exec_spot(playlist, prev_spot),
                                         "up" => exec_spot(playlist, spot),
                                         "down" => "setang 89 #{spot.yaw} 0"
                                       }),
                  spot.command,
                  %(say_team "#{message(playlist, spot)}")
                ], owner: playlist.slug)
    end

    def empty_playlist_actions(playlist)
      message = echo_command("#{playlist.name}: no valid spots")
      ARROW_ACTIONS.values.to_h { |action| [action.fetch(:action), message] }
    end

    def spot_shortcut_lines(playlist)
      return [] unless @spot_shortcut_count.positive?

      (1..@spot_shortcut_count).map do |index|
        spot = playlist.spots[index - 1]
        command = spot ? exec_spot(playlist, spot) : echo_command("#{playlist.name}: spot #{index} is not available")
        alias_command(spot_shortcut_alias(index), command)
      end
    end

    def spot_shortcut_alias(index)
      "#{SPOT_SHORTCUT_PREFIX}#{index}"
    end

    def capture_alias_line
      alias_command("ut_save", [
        SV_CHEATS_LINE,
        "say_team Utilizer capture",
        echoln(CaptureProtocol::CAPTURE_MARKER),
        "getpos"
      ].join("; "))
    end

    def write_manifest(playlists:, previous_manifest: nil, removed_owner_slugs: [])
      FileUtils.mkdir_p(console_folder)
      payload = if previous_manifest
                  scoped_manifest_payload(previous_manifest, playlists, removed_owner_slugs)
                else
                  full_manifest_payload(playlists)
                end
      content = "#{JSON.pretty_generate(payload)}\n"
      return if File.file?(manifest_path) && File.read(manifest_path, encoding: "UTF-8") == content

      File.write(manifest_path, content, encoding: "UTF-8")
    end

    def full_manifest_payload(playlists)
      {
        "version" => MANIFEST_VERSION,
        "generated_at" => Time.now.utc.iso8601,
        "files" => @generated_files.uniq.sort,
        "owners" => {
          RUNTIME_OWNER => runtime_manifest_files,
          "playlists" => playlist_manifest_entries(playlists)
        }
      }
    end

    def scoped_manifest_payload(previous_manifest, scoped_playlists, removed_owner_slugs)
      previous_manifest ||= { "files" => [], "owners" => {} }
      removed_files = removed_owner_slugs.flat_map do |slug|
        playlist_manifest_files_for_slug(previous_manifest, slug)
      end
      previous_files = manifest_files(previous_manifest) - removed_files
      owners = previous_manifest.fetch("owners", {})
      playlists = owners.fetch("playlists", {}).dup
      removed_owner_slugs.each { |slug| playlists.delete(slug) }
      scoped_playlists.each { |playlist| playlists[playlist.slug] = playlist_manifest_entry(playlist) }

      {
        "version" => MANIFEST_VERSION,
        "generated_at" => Time.now.utc.iso8601,
        "files" => (previous_files + @generated_files).uniq.sort,
        "owners" => {
          RUNTIME_OWNER => (Array(owners[RUNTIME_OWNER]) + runtime_manifest_files).uniq.sort,
          "playlists" => playlists
        }
      }
    end

    def playlist_manifest_entries(playlists)
      playlists.to_h { |playlist| [playlist.slug, playlist_manifest_entry(playlist)] }
    end

    def playlist_manifest_entry(playlist)
      {
        "name" => playlist.name,
        "map_code" => playlist.map_code,
        "command_alias" => playlist.command_alias,
        "files" => @playlist_files[playlist.slug].uniq.sort
      }
    end

    def playlist_manifest_files(manifest, playlist)
      playlist_manifest_files_for_slug(manifest, playlist.slug)
    end

    def playlist_manifest_files_for_slug(manifest, slug)
      Array(manifest&.dig("owners", "playlists", slug, "files")).map { |path| clean_path(path.to_s) }
    end

    def manifest_playlist_owner_slugs(manifest)
      owners = manifest&.dig("owners", "playlists")
      return [] unless owners.is_a?(Hash)

      owners.keys
    end

    def map_manifest_owner_slugs(manifest, map_code)
      owners = manifest&.dig("owners", "playlists")
      return [] unless owners.is_a?(Hash)

      owners.filter_map do |slug, entry|
        entry = {} unless entry.is_a?(Hash)
        slug if manifest_entry_in_map?(slug, entry, map_code)
      end
    end

    def manifest_entry_in_map?(slug, entry, map_code)
      return true if entry["map_code"].to_s == map_code

      legacy_name = entry["name"].to_s
      legacy_slug = PlaylistAlias.slug(legacy_name)
      slug.to_s.start_with?("#{map_code}_") || legacy_slug.start_with?("#{map_code}_")
    end

    def manifest_files(manifest)
      Array(manifest.fetch("files", [])).map { |path| clean_path(path.to_s) }
    end

    def runtime_manifest_files
      playlist_files = @playlist_files.values.flatten
      (@generated_files - playlist_files).uniq.sort
    end

    def cfg_folder_warnings
      warnings = @config.respond_to?(:csgo_cfg_folder_warnings) ? @config.csgo_cfg_folder_warnings : []
      normalized = clean_path(@csgo_cfg_folder).downcase
      warnings << "CS2 cfg folder path does not end with game/csgo/cfg." unless normalized.end_with?("/game/csgo/cfg")
      warnings.uniq
    end

    def skipped_reasons(playlists)
      playlists.flat_map do |playlist|
        playlist.skipped_rows.map do |row|
          "#{playlist.name} row #{row.row_number}: #{row.reason}"
        end
      end
    end

    def root_cfg_file(name)
      File.join(@csgo_cfg_folder, "#{name}.cfg")
    end

    def helper_root
      File.join(console_folder, "playlists")
    end

    def runtime_root
      File.join(console_folder, "runtime")
    end

    def legacy_generated_folder
      File.join(console_folder, "generated")
    end

    def console_folder
      File.join(@csgo_cfg_folder, "console_utilizer")
    end

    def manifest_path
      File.join(console_folder, MANIFEST_FILE)
    end

    def spot_cfg_file(playlist, spot)
      File.join(helper_root, playlist.slug, "spots", "#{spot_filename(spot)}.cfg")
    end

    def spot_cfg_path(playlist, spot)
      "console_utilizer/playlists/#{playlist.slug}/spots/#{spot_filename(spot)}"
    end

    def runtime_gate_file(action)
      RuntimeGates.runtime_gate_file(@csgo_cfg_folder, action)
    end

    def runtime_gate_path(action)
      RuntimeGates.runtime_gate_path(action)
    end

    def spot_filename(spot)
      format("%03d", spot.index)
    end

    def exec_spot(playlist, spot)
      "exec #{spot_cfg_path(playlist, spot)}"
    end

    def arrow_runtime_lines(commands)
      ARROW_ACTIONS.flat_map do |key, action|
        alias_name = action.fetch(:alias)
        action_name = action.fetch(:action)
        [
          alias_command(alias_name, commands.fetch(action_name)),
          bind(key, "exec #{runtime_gate_path(action)}")
        ]
      end
    end

    def playlist_marker(playlist)
      echoln("#{CaptureProtocol::PLAYLIST_MARKER} #{playlist.slug}")
    end

    def bind(key, command)
      %(bind #{key} "#{quote_bind(command)}")
    end

    def alias_command(name, command)
      %(alias #{name} "#{quote_bind(command)}")
    end

    def echo_command(text)
      "echo #{quote_text(text)}"
    end

    def echo(text)
      echo_command(text)
    end

    def echoln(text)
      %(echoln #{quote_text(text)})
    end

    def message(playlist, spot)
      quote_text("[#{spot.index}/#{playlist.spots.length}] #{spot.description}")
    end

    def quote_text(text)
      text.to_s.tr(';"', "'")
    end

    def quote_bind(text)
      text.to_s.tr('"', "'")
    end

    def write_cfg(path, lines, owner: nil)
      relative_path = write_file(path, cfg_content(lines))
      @playlist_files[owner] << relative_path if owner
    end

    def cfg_content(lines)
      "#{([GENERATED_HEADER] + lines).join("\n")}\n"
    end

    def write_file(path, content)
      assert_inside_cfg!(path)
      raise "Refusing to overwrite non-Utilizer cfg file: #{path}" if File.file?(path) && !generated_file?(path)

      FileUtils.mkdir_p(File.dirname(path))
      File.write(path, content, encoding: "UTF-8") unless File.file?(path) &&
                                                          File.read(path, encoding: "UTF-8") == content
      relative_path = relative_to_cfg(path)
      @generated_files << relative_path
      relative_path
    end

    def generated_file?(path)
      File.open(path, "r:UTF-8") { |file| file.readline.chomp == GENERATED_HEADER }
    rescue EOFError, SystemCallError
      false
    end

    def assert_inside_cfg!(path)
      target = clean_path(File.expand_path(path))
      root = clean_path(File.expand_path(@csgo_cfg_folder))
      return if target.start_with?("#{root}/")

      raise "Refusing to write outside CS2 cfg folder: #{target}"
    end

    def relative_to_cfg(path)
      target = clean_path(File.expand_path(path))
      root = clean_path(File.expand_path(@csgo_cfg_folder))
      target.delete_prefix("#{root}/")
    end

    def clean_path(path)
      path.tr('\\', "/")
    end
  end
end
