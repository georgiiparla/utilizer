# frozen_string_literal: true

require_relative "utilizer/config"
require_relative "utilizer/maps"
require_relative "utilizer/process_lock"
require_relative "utilizer/command_validator"
require_relative "utilizer/cfg_sync"
require_relative "utilizer/playlist_document"
require_relative "utilizer/playlists"
require_relative "utilizer/web_launcher"
require_relative "utilizer/web_server"

class Utilizer
  INTERNAL_SERVER_COMMAND = "serve-web"
  DEV_STOP_COMMAND = "dev-stop"
  DEV_RESTART_COMMAND = "dev-restart"
  DEV_STATUS_COMMAND = "dev-status"

  def initialize(args)
    @command = args[0]
    @args = args[1..] || []
    @config = Config.new
  end

  def run
    if @command.nil?
      WebLauncher.new(@config).open
    elsif @command == INTERNAL_SERVER_COMMAND
      serve_web
    elsif dev_command?
      run_dev_command
    elsif %w[help -h --help].include?(@command)
      puts usage
    else
      warn usage
      exit 1
    end
  rescue StandardError => e
    warn "Error: #{e.message}"
    exit 1
  end

  private

  def usage
    text = <<~TEXT
      Usage:
        utilizer

      Starts the local Utilizer web app.
    TEXT
    return text if packaged_executable?

    <<~TEXT
      #{text.chomp}

      Development:
        ruby main.rb              # start if needed and open browser
        ruby main.rb #{DEV_RESTART_COMMAND}  # restart and open a fresh browser tab
        ruby main.rb #{DEV_STOP_COMMAND}     # stop the web app
        ruby main.rb #{DEV_STATUS_COMMAND}   # print running, stopped, or port busy
    TEXT
  end

  def dev_command?
    [
      DEV_RESTART_COMMAND,
      DEV_STOP_COMMAND,
      DEV_STATUS_COMMAND
    ].include?(@command)
  end

  def run_dev_command
    abort "#{@command} is only available when running from source." if packaged_executable?

    launcher = WebLauncher.new(@config)
    case @command
    when DEV_RESTART_COMMAND
      launcher.restart(open_browser: true)
    when DEV_STOP_COMMAND
      launcher.stop
    when DEV_STATUS_COMMAND
      puts launcher.status
    end
  end

  def serve_web
    port = @args[0]&.to_i
    abort "Usage: utilizer #{INTERNAL_SERVER_COMMAND} PORT" if port.to_i <= 0

    WebServer.new(@config, port: port, token: @args[1]).run
  end

  def packaged_executable?
    File.extname($PROGRAM_NAME).casecmp(".exe").zero?
  end
end
