# frozen_string_literal: true

require "time"
require "securerandom"
require "webrick"

require_relative "cfg_sync"
require_relative "event_log"
require_relative "process_lock"
require_relative "runtime_gates"
require_relative "web_app"
require_relative "web_registry"

class Utilizer
  class WebServer
    STARTUP_TIMEOUT_SECONDS = 30 * 60
    HEARTBEAT_TIMEOUT_SECONDS = 4 * 60 * 60
    HEARTBEAT_INTERVAL_SECONDS = 15

    def initialize(config, port:, token: nil)
      @config = config
      @port = port.to_i
      @token = if token.to_s.empty?
                 @config.respond_to?(:auth_token) ? @config.auth_token : SecureRandom.hex(32)
               else
                 token.to_s
               end
      @registry = WebRegistry.new(config)
      @event_log = EventLog.new(@config.event_log_path)
    end

    def run
      ProcessLock.new(
        @config.web_server_lock_path,
        busy_message: "Another Utilizer web app is already running."
      ).synchronize(blocking: false) do
        run_locked
      end
    end

    private

    def run_locked
      @server = log_startup_phase("build_server") { build_server }
      @url = "http://127.0.0.1:#{@port}/"
      @started_at = Time.now.utc
      @last_heartbeat_at = nil

      log_startup_phase("restore_runtime_actions") { restore_runtime_actions }
      log_startup_phase("register_server") { register_server }
      print_started
      trap_shutdown("INT")
      trap_shutdown("TERM")
      start_expiry_monitor
      @event_log.info("startup_phase", phase: "server_starting", url: @url)
      @server.start
    ensure
      clear_runtime_actions
      @registry&.clear_if_pid(Process.pid)
      puts "Utilizer web app stopped."
    end

    def register_server
      @registry.write(
        "pid" => Process.pid,
        "url" => @url,
        "token" => @token,
        "port" => @port,
        "started_at" => @started_at.iso8601
      )
    end

    def build_server
      app = log_startup_phase("web_app_initialized") do
        WebApp.new(
          @config,
          port: @port,
          token: @token,
          on_shutdown: method(:schedule_shutdown),
          on_heartbeat: method(:receive_heartbeat)
        )
      end
      server = WEBrick::HTTPServer.new(
        BindAddress: "127.0.0.1",
        Port: @port,
        AccessLog: [],
        Logger: WEBrick::Log.new(File::NULL, WEBrick::Log::WARN)
      )

      server.mount_proc("/") { |request, response| app.call(request, response) }
      server
    end

    def log_startup_phase(phase)
      started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      result = yield
      @event_log.info("startup_phase", phase: phase, duration_ms: elapsed_ms(started_at))
      result
    rescue StandardError => e
      @event_log.error("startup_phase_failed",
                       phase: phase,
                       duration_ms: elapsed_ms(started_at),
                       type: e.class.name,
                       message: e.message)
      raise
    end

    def elapsed_ms(started_at)
      ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at) * 1000).round
    end

    def receive_heartbeat
      @last_heartbeat_at = Time.now.utc
    end

    def start_expiry_monitor
      Thread.new do
        loop do
          sleep HEARTBEAT_INTERVAL_SECONDS
          break if @server.status == :Stop

          next unless heartbeat_expired?

          puts "Utilizer web app expired after browser heartbeat stopped."
          $stdout.flush
          @server.shutdown
          break
        end
      end
    end

    def heartbeat_expired?
      if @last_heartbeat_at
        Time.now.utc - @last_heartbeat_at > HEARTBEAT_TIMEOUT_SECONDS
      else
        Time.now.utc - @started_at > STARTUP_TIMEOUT_SECONDS
      end
    end

    def schedule_shutdown
      Thread.new do
        sleep 0.2
        @server.shutdown
      end
    end

    def trap_shutdown(signal)
      trap(signal) do
        puts
        puts "Stopping Utilizer web app..."
        $stdout.flush
        @server.shutdown
      end
    rescue ArgumentError
      nil
    end

    def print_started
      puts
      puts "Utilizer web app"
      puts "URL: #{@url}"
      puts "Server: local only (127.0.0.1)"
      puts "Use the tray icon to close it."
      $stdout.flush
    end

    def clear_runtime_actions
      cleared = RuntimeGates.clear(@config)
      puts "Cleared #{cleared} Utilizer arrow gate files." if cleared.positive?
    rescue StandardError => e
      warn "Could not clear Utilizer arrow gate files: #{e.message}"
    end

    def restore_runtime_actions
      restored = RuntimeGates.restore(@config)
      puts "Restored #{restored} Utilizer arrow gate files." if restored.positive?
    rescue StandardError => e
      warn "Could not restore Utilizer arrow gate files: #{e.message}"
    end
  end
end
