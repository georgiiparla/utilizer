# frozen_string_literal: true

require "csv"
require "fileutils"
require "securerandom"
require "stringio"

require_relative "command_validator"

class Utilizer
  class PlaylistDocument
    HEADER = %w[command description link comment].freeze
    Row = Struct.new(:command, :description, :link, :comment, keyword_init: true)

    attr_reader :path, :rows

    def self.create(path)
      return false if File.exist?(path)

      FileUtils.mkdir_p(File.dirname(path))
      CSV.open(path, "w", encoding: "UTF-8") do |csv|
        csv << HEADER
      end
      true
    end

    def self.load(path)
      rows = CSV.read(path, headers: true, encoding: "bom|utf-8").map do |row|
        Row.new(command: row["command"].to_s, description: row["description"].to_s, link: row["link"].to_s,
                comment: row["comment"].to_s)
      end

      new(path, rows)
    end

    def initialize(path, rows)
      @path = path
      @rows = rows
    end

    def name
      File.basename(path, ".csv")
    end

    def filename
      File.basename(path)
    end

    def content_for(rows)
      self.class.csv_content(rows)
    end

    def save!(rows, content: nil)
      content ||= content_for(rows)
      return false if File.file?(path) && File.binread(path) == content

      temp_path = self.class.temp_path_for(path)
      File.binwrite(temp_path, content)
      FileUtils.mv(temp_path, path)
      true
    ensure
      FileUtils.rm_f(temp_path) if temp_path
    end

    def self.csv_content(rows)
      output = StringIO.new
      csv = CSV.new(output)
      csv << HEADER
      rows.each do |row|
        normalized = row_hash(row)
        command = normalized.fetch(:command).to_s.strip
        command = CommandValidator.normalize(command) unless command.empty?
        csv << [command, normalized.fetch(:description), normalized.fetch(:link, ""), normalized.fetch(:comment, "")]
      end
      output.string
    end

    def self.temp_path_for(path)
      "#{path}.tmp-#{Process.pid}-#{Thread.current.object_id}-#{SecureRandom.hex(4)}"
    end

    def self.row_hash(row)
      if row.respond_to?(:command)
        return { command: row.command, description: row.description, link: row.link, comment: row.comment }
      end

      {
        command: row[:command] || row["command"],
        description: row[:description] || row["description"],
        link: row[:link] || row["link"] || "",
        comment: row[:comment] || row["comment"] || ""
      }
    end
  end
end
