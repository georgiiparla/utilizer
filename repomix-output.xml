# frozen_string_literal: true

require "fileutils"
require "rbconfig"

task default: :build

DIST_DIR = "dist"
INSTALLER_PATH = File.join(DIST_DIR, "UtilizerSetup.exe")
INSTALLER_ARTIFACTS = %w[utilizer.exe utilizer-web.exe logo.ico].freeze

def app_version
  version_line = File.readlines("utilizer.iss").find { |line| line.start_with?("AppVersion=") }
  abort "AppVersion is missing from utilizer.iss." unless version_line

  version_line.split("=", 2).last.strip
end

def release_tag
  "v#{app_version}"
end

def env_flag?(name)
  %w[1 true yes].include?(ENV.fetch(name, "").downcase)
end

def command_ok?(*command)
  system(*command, out: File::NULL, err: File::NULL)
end

def run!(*command)
  puts command.join(" ")
  abort "Command failed." unless system(*command)
end

def require_clean_worktree!
  return if command_ok?("git", "diff", "--quiet") && command_ok?("git", "diff", "--cached", "--quiet")

  abort "Working tree has uncommitted changes. Commit them before publishing source archives."
end

def tag_exists?(tag)
  command_ok?("git", "rev-parse", "--verify", "--quiet", "refs/tags/#{tag}") ||
    command_ok?("git", "ls-remote", "--exit-code", "--tags", "origin", "refs/tags/#{tag}")
end

desc "Build the standalone Utilizer executable"
task :build do
  FileUtils.rm_rf(DIST_DIR)
  FileUtils.mkdir_p(DIST_DIR)

  ruby_files = Dir.glob("lib/**/*.rb")
  asset_files = Dir.glob("lib/utilizer/web/**/*").select { |path| File.file?(path) && File.extname(path) != ".rb" }
  aibika = Gem.bin_path("aibika", "aibika")

  args = [
    "main.rb",
    *ruby_files,
    *asset_files,
    "logo.ico",
    "--output", File.join(DIST_DIR, "utilizer-web.exe"),
    "--icon", "logo.ico",
    "--add-all-core",
    "--gem-full=webrick",
    "--gem-full=csv",
    "--chdir-first",
    "--console"
  ]

  abort "Ruby web app build failed." unless system(RbConfig.ruby, aibika, *args)
  abort "Tray app build failed." unless system(
    "go",
    "build",
    "-ldflags", "-H=windowsgui -s -w",
    "-o", File.join("..", "..", DIST_DIR, "utilizer.exe"),
    ".",
    chdir: "native/utilizer-tray"
  )
  FileUtils.cp("logo.ico", File.join(DIST_DIR, "logo.ico"))
  puts "Built #{DIST_DIR}/utilizer.exe and #{DIST_DIR}/utilizer-web.exe"
end

desc "Build the Windows installer"
task installer: :build do
  unless system("iscc utilizer.iss")
    abort "Installer build failed. Make sure Inno Setup is installed and iscc is in PATH."
  end
  INSTALLER_ARTIFACTS.each { |name| FileUtils.rm_f(File.join(DIST_DIR, name)) }
  puts "Built #{DIST_DIR}/UtilizerSetup.exe"
  puts "Distribute #{DIST_DIR}/UtilizerSetup.exe"
end

desc "Create or replace the GitHub release for utilizer.iss AppVersion"
task :release do
  Rake::Task[:installer].invoke unless env_flag?("SKIP_BUILD")

  replace = env_flag?("REPLACE")
  tag = release_tag
  title = "Utilizer #{app_version}"
  notes = ENV.fetch("RELEASE_NOTES", "Early Utilizer distro.")

  abort "#{INSTALLER_PATH} is missing. Run rake installer first." unless File.file?(INSTALLER_PATH)
  require_clean_worktree!

  release_exists = command_ok?("gh", "release", "view", tag)
  tag_exists = tag_exists?(tag)

  abort "Release #{tag} already exists. Re-run with REPLACE=1 to substitute it." if release_exists && !replace

  if tag_exists
    abort "Tag #{tag} already exists. Re-run with REPLACE=1 to move it." unless replace

    run!("git", "tag", "-f", tag, "HEAD")
    run!("git", "push", "origin", tag, "--force")
  else
    run!("git", "tag", tag, "HEAD")
    run!("git", "push", "origin", tag)
  end

  if release_exists
    run!("gh", "release", "edit", tag, "--title", title, "--notes", notes)
    run!("gh", "release", "upload", tag, INSTALLER_PATH, "--clobber")
  else
    run!("gh", "release", "create", tag, INSTALLER_PATH, "--title", title, "--notes", notes)
  end

  puts "Published #{tag}: #{INSTALLER_PATH}"
end
</file>

