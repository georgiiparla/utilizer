<file path="utilizer-ruby/lib/utilizer/web/assets/controllers/app_controller.js">
import { Controller } from "https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/+esm";
import { copyText } from "../lib/clipboard.js";
import { playlistActionStorageKey, readSessionJson } from "../lib/storage.js";

export default class extends Controller {
  static targets = ["confirmDialog", "confirmTitle", "confirmBody", "confirmAction"];

  connect() {
    this.pendingConfirm = null;
    this.activeCopyButton = null;
    this.boundConfirmRequest = this.confirmRequest.bind(this);
    this.boundDocumentClick = this.documentClick.bind(this);
    this.boundFormSubmit = this.formSubmit.bind(this);
    this.boundDialogClose = this.dialogClose.bind(this);

    document.addEventListener("utilizer:confirm", this.boundConfirmRequest);
    document.addEventListener("click", this.boundDocumentClick);
    document.addEventListener("submit", this.boundFormSubmit, true);
    if (this.hasConfirmDialogTarget) {
      this.confirmDialogTarget.addEventListener("close", this.boundDialogClose);
    }

    this.preloadImages();
    this.sendHeartbeat();
    this.heartbeatInterval = window.setInterval(() => this.sendHeartbeat(), 15000);
  }

  disconnect() {
    document.removeEventListener("utilizer:confirm", this.boundConfirmRequest);
    document.removeEventListener("click", this.boundDocumentClick);
    document.removeEventListener("submit", this.boundFormSubmit, true);
    if (this.hasConfirmDialogTarget) {
      this.confirmDialogTarget.removeEventListener("close", this.boundDialogClose);
    }
    if (this.heartbeatInterval) window.clearInterval(this.heartbeatInterval);
  }

  confirmAction() {
    const action = this.pendingConfirm;
    this.pendingConfirm = null;
    if (this.hasConfirmDialogTarget) this.confirmDialogTarget.close();
    if (action) action();
  }

  confirmRequest(event) {
    event.preventDefault();
    this.showConfirm(event.detail || {});
  }

  showConfirm({
    title,
    body,
    actionLabel = "Confirm",
    actionClass = "btn-neutral",
    onConfirm,
  }) {
    this.pendingConfirm = onConfirm;

    if (
      !this.hasConfirmDialogTarget ||
      !this.hasConfirmTitleTarget ||
      !this.hasConfirmBodyTarget ||
      !this.hasConfirmActionTarget
    ) {
      if (window.confirm(`${title}\n\n${body}`)) this.confirmAction();
      return;
    }

    this.confirmTitleTarget.textContent = title;
    this.confirmBodyTarget.textContent = body;
    this.confirmActionTarget.textContent = actionLabel;
    this.confirmActionTarget.className = `btn btn-sm utilizer-modal-button ${actionClass}`;
    this.confirmDialogTarget.showModal();
  }

  dialogClose() {
    this.pendingConfirm = null;
  }

  formSubmit(event) {
    const form = event.target.closest("form[data-confirm]");
    if (!form) return;

    const message = form.dataset.confirm;
    if (!message) return;

    event.preventDefault();
    const submitter = event.submitter || form.querySelector('button[type="submit"]');
    const submitterLabel = submitter
      ? submitter.textContent.trim() ||
        submitter.getAttribute("aria-label") ||
        submitter.getAttribute("title") ||
        submitter.value ||
        ""
      : "";

    this.showConfirm({
      title: form.dataset.confirmTitle || "Confirm",
      body: message,
      actionLabel: form.dataset.confirmAction || submitterLabel || "Confirm",
      actionClass: form.dataset.confirmClass || "btn-neutral",
      onConfirm: () => form.submit(),
    });
  }

  documentClick(event) {
    this.dismissNotifications(event);
    this.closeDropdowns(event);
    this.copyCommand(event);
  }

  dismissNotifications(event) {
    const pendingPlaylistAction = readSessionJson(playlistActionStorageKey);
    document.querySelectorAll("[data-notification-bar]:not(.hidden)").forEach((notification) => {
      if (pendingPlaylistAction && notification.id === "dashboard-notification-bar") return;
      if (!notification.contains(event.target)) notification.classList.add("hidden");
    });
  }

  closeDropdowns(event) {
    document.querySelectorAll("details.dropdown[open]").forEach((dropdown) => {
      if (!dropdown.contains(event.target)) dropdown.open = false;
    });
  }

  async copyCommand(event) {
    const button = event.target.closest("[data-copy-command]");
    if (!button) return;

    event.preventDefault();
    if (!button.dataset.copyOriginal) button.dataset.copyOriginal = button.innerHTML;

    if (this.activeCopyButton && this.activeCopyButton !== button) {
      this.restoreCopyButton(this.activeCopyButton);
    }

    try {
      await copyText(button.dataset.copyCommand);
      this.setCopyButtonState(button, "copied");
      this.activeCopyButton = button;
    } catch (e) {
      this.setCopyButtonState(button, "failed");
      this.activeCopyButton = button;
    }
  }

  setCopyButtonState(button, state) {
    if (button.dataset.copyIcon === "true") {
      const icon = state === "failed" ? "ph-x" : "ph-copy";
      button.innerHTML = `<i class="ph-bold ${icon}"></i>`;
      return;
    }

    button.innerHTML =
      state === "copied" ? "<span>Copied</span>" : "<span>Copy failed</span>";
  }

  restoreCopyButton(button) {
    button.innerHTML = button.dataset.copyOriginal;
  }

  preloadImages() {
    document.querySelectorAll("[data-preload-images]").forEach((container) => {
      const urls = (container.dataset.preloadImages || "")
        .split(",")
        .map((url) => url.trim())
        .filter(Boolean);
      urls.forEach((url) => {
        const image = new Image();
        image.src = url;
      });
    });
  }

  sendHeartbeat() {
    fetch("/heartbeat", { method: "POST", keepalive: true }).catch(() => {});
  }
}
</file>

<file path="utilizer-ruby/lib/utilizer/web/assets/controllers/dashboard_playlists_controller.js">
import { Controller } from "https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/+esm";
import { requestConfirm } from "../lib/confirm.js";
import { submitPostForm } from "../lib/forms.js";
import { postFetch } from "../lib/http.js";
import { readJsonScript } from "../lib/json.js";
import { positionContextMenu } from "../lib/positioning.js";
import { clearSearchInput, matchesSearch, searchTerms } from "../lib/search.js";
import {
  playlistActionNoticeKey,
  playlistActionStorageKey,
  readSessionJson,
  removeSessionItem,
  writeSessionJson,
} from "../lib/storage.js";

export default class extends Controller {
  static targets = [
    "table",
    "search",
    "searchEmpty",
    "notificationBar",
    "alert",
    "contextMenu",
  ];

  connect() {
    if (!this.hasTableTarget || !window.Tabulator) return;

    this.pendingPlaylistAction = readSessionJson(playlistActionStorageKey);
    this.playlists = this.visiblePlaylistData(readJsonScript("dashboard-playlists-data", []));
    this.activePlaylistSlug = null;
    this.playlistContextMenuData = null;

    this.boundDocumentClick = this.documentClick.bind(this);
    this.boundDocumentKeydown = this.documentKeydown.bind(this);
    this.boundCloseContextMenu = this.closeContextMenu.bind(this);
    document.addEventListener("click", this.boundDocumentClick);
    document.addEventListener("keydown", this.boundDocumentKeydown);
    window.addEventListener("scroll", this.boundCloseContextMenu, true);
    window.addEventListener("resize", this.boundCloseContextMenu);

    this.table = new Tabulator(this.tableTarget, {
      data: this.playlists,
      index: "name",
      height: "100%",
      layout: "fitColumns",
      resizableColumnFit: true,
      resizableColumnGuide: true,
      rowHeight: 42,
      columnDefaults: {
        resizable: "header",
        vertAlign: "middle",
      },
      placeholder: "No playlists. Right-click to create one.",
      initialSort: [{ column: "filename", dir: "asc" }],
      columns: [
        {
          title: "Filename",
          field: "filename",
          sorter: "string",
          formatter: (cell) => this.filenameCell(cell),
          minWidth: 280,
          widthGrow: 5,
          widthShrink: 1,
        },
        {
          title: "CS2 Command",
          field: "commandAlias",
          headerSort: false,
          formatter: (cell) => this.commandCell(cell),
          minWidth: 240,
          widthGrow: 4,
          widthShrink: 1,
        },
        {
          title: "Spots",
          field: "spotsCount",
          sorter: "number",
          formatter: (cell) => cell.getData().spotsLabel,
          hozAlign: "center",
          headerHozAlign: "center",
          minWidth: 88,
          width: 96,
          widthGrow: 0,
          widthShrink: 0,
        },
      ],
      rowFormatter: (row) => this.formatRow(row),
    });
    this.table.on("rowClick", (event, row) => this.selectPendingTarget(event, row));

    this.applyFilter();
    this.initializePendingPlaylistAction();
    this.pollRuntimeState();
    this.runtimeInterval = window.setInterval(() => this.pollRuntimeState(), 2000);
  }

  disconnect() {
    document.removeEventListener("click", this.boundDocumentClick);
    document.removeEventListener("keydown", this.boundDocumentKeydown);
    window.removeEventListener("scroll", this.boundCloseContextMenu, true);
    window.removeEventListener("resize", this.boundCloseContextMenu);
    if (this.runtimeInterval) window.clearInterval(this.runtimeInterval);
    if (this.table) this.table.destroy();
  }

  visiblePlaylistData(playlists) {
    if (!this.pendingPlaylistAction) return playlists;

    return playlists.filter(
      (playlist) => playlist.name !== this.pendingPlaylistAction.sourceName,
    );
  }

  filenameCell(cell) {
    const data = cell.getData();
    const wrapper = document.createElement("div");
    const link = document.createElement("a");

    link.className = "utilizer-playlist-link";
    link.href = data.playlistUrl;
    link.textContent = data.filename;
    wrapper.appendChild(link);

    if (data.error) {
      const error = document.createElement("div");
      error.className = "text-xs text-error mt-1";
      error.textContent = data.error;
      wrapper.appendChild(error);
    }

    return wrapper;
  }

  commandCell(cell) {
    const data = cell.getData();
    if (!data.commandAlias) {
      const invalid = document.createElement("span");
      invalid.className = "text-xs text-error font-mono";
      invalid.textContent = "invalid alias";
      return invalid;
    }

    const button = document.createElement("button");
    const label = document.createElement("span");
    const icon = document.createElement("i");

    button.type = "button";
    button.className = "utilizer-playlist-command";
    button.dataset.copyCommand = data.commandAlias;
    button.title = "Copy CS2 command";
    label.className = "truncate";
    label.textContent = data.commandAlias;
    icon.className = "ph-bold ph-copy text-xs shrink-0";
    button.append(label, icon);
    return button;
  }

  formatRow(row) {
    const data = row.getData();
    const element = row.getElement();

    element.dataset.playlistName = data.name;
    element.dataset.playlistSlug = data.slug;
    element.dataset.runtimeActive =
      this.activePlaylistSlug && data.slug === this.activePlaylistSlug ? "true" : "false";
  }

  applyFilter() {
    if (!this.table) return;

    const terms = searchTerms(this.hasSearchTarget ? this.searchTarget.value : "");
    if (terms.length === 0) {
      this.table.clearFilter(true);
      this.updateSearchEmpty(false);
      return;
    }

    this.table.setFilter((data) => matchesSearch(data.searchText, terms));
    this.updateSearchEmpty(this.table.getData("active").length === 0 && this.playlists.length > 0);
  }

  clearSearch(event) {
    if (event.key !== "Escape" || !clearSearchInput(this.searchTarget)) return;

    event.preventDefault();
    this.applyFilter();
  }

  updateSearchEmpty(show) {
    if (!this.hasSearchEmptyTarget) return;

    this.searchEmptyTarget.hidden = !show;
    this.searchEmptyTarget.classList.toggle("hidden", !show);
  }

  markActivePlaylist(slug) {
    if (slug === this.activePlaylistSlug) return;

    this.activePlaylistSlug = slug;
    this.table?.getRows().forEach((row) => this.formatRow(row));
  }

  async pollRuntimeState() {
    try {
      const response = await fetch("/runtime/state");
      const data = await response.json();
      this.markActivePlaylist(data.ok ? data.selected_playlist?.slug || null : null);
    } catch (e) {
      this.markActivePlaylist(null);
    }
  }

  showAlert(message, type = "info") {
    if (!this.hasNotificationBarTarget || !this.hasAlertTarget) return;

    this.alertTarget.textContent = message;
    this.alertTarget.className = `text-lg font-mono text-${type}`;
    this.notificationBarTarget.classList.remove("hidden");
  }

  initializePendingPlaylistAction() {
    if (!this.pendingPlaylistAction) return;

    this.showAlert(
      Array.isArray(this.pendingPlaylistAction.spots)
        ? "Select a playlist to copy these spots to."
        : "Select a playlist to copy this spot to.",
      "info",
    );
  }

  clearPendingPlaylistAction() {
    const returnUrl = this.pendingPlaylistAction?.returnUrl || "/";
    removeSessionItem(playlistActionStorageKey);
    window.location.href = returnUrl;
  }

  finishPendingPlaylistAction(notice) {
    writeSessionJson(playlistActionNoticeKey, {
      type: "success",
      ...notice,
    });
    removeSessionItem(playlistActionStorageKey);
    window.location.href = this.pendingPlaylistAction.returnUrl || "/";
  }

  async runPendingPlaylistAction(targetName) {
    if (!this.pendingPlaylistAction || !targetName) return;

    const sourcePath = `/maps/${encodeURIComponent(this.pendingPlaylistAction.mapCode)}/playlists/${encodeURIComponent(this.pendingPlaylistAction.sourceName)}`;
    const params = { target: targetName };
    if (Array.isArray(this.pendingPlaylistAction.spots)) {
      params.spots = JSON.stringify(this.pendingPlaylistAction.spots);
    } else {
      Object.assign(params, this.pendingPlaylistAction.spot || {});
    }

    try {
      const response = await postFetch(`${sourcePath}/copy`, params);
      const data = await response.json();
      if (!data.ok) {
        this.showAlert(data.message || "Playlist action failed.", "error");
        return;
      }
      this.finishPendingPlaylistAction({
        message: data.message || `Copied spot to ${targetName}.`,
        linkText: data.target_filename || targetName,
        linkUrl: data.target_url || null,
      });
    } catch (e) {
      this.showAlert("Playlist action failed.", "error");
    }
  }

  selectPendingTarget(event, row) {
    if (!this.pendingPlaylistAction) return;

    event.preventDefault();
    const targetName = row.getData().name;
    const selectedCount = Array.isArray(this.pendingPlaylistAction.spots)
      ? this.pendingPlaylistAction.spots.length
      : 1;
    requestConfirm({
      title:
        selectedCount === 1
          ? `Copy spot to ${targetName}?`
          : `Copy ${selectedCount} spots to ${targetName}?`,
      body:
        selectedCount === 1
          ? "Append this spot to the selected playlist."
          : "Append these spots to the selected playlist.",
      actionLabel: "Copy",
      actionClass: "btn-neutral",
      onConfirm: () => this.runPendingPlaylistAction(targetName),
    });
  }

  openContextMenu(event) {
    if (this.pendingPlaylistAction || !this.hasContextMenuTarget || !window.FloatingUIDOM) return;

    event.preventDefault();
    this.playlistContextMenuData = null;

    const rowElement = event.target.closest(".tabulator-row");
    if (rowElement?.dataset.playlistName) {
      const row = this.table.getRow(rowElement.dataset.playlistName);
      this.playlistContextMenuData = row ? row.getData() : null;
    }

    this.contextMenuTarget.querySelectorAll("[data-playlist-menu-action]").forEach((button) => {
      const action = button.dataset.playlistMenuAction;
      const visible = this.playlistContextMenuData ? action === "delete" : action === "new";
      button.classList.toggle("hidden", !visible);
      button.classList.toggle("flex", visible);
    });

    this.contextMenuTarget.classList.remove("hidden");
    this.contextMenuTarget.setAttribute("aria-hidden", "false");
    positionContextMenu(this.contextMenuTarget, event);
  }

  runContextAction(event) {
    const button = event.target.closest("[data-playlist-menu-action]");
    if (!button) return;

    event.preventDefault();
    event.stopPropagation();
    this.closeContextMenu();

    const action = button.dataset.playlistMenuAction;
    if (action === "new") {
      this.createPlaylist();
    } else if (action === "delete" && this.playlistContextMenuData) {
      this.deletePlaylist(this.playlistContextMenuData);
    }
  }

  createPlaylist() {
    const name = window.prompt("New playlist filename");
    if (!name || !name.trim()) return;

    submitPostForm(this.tableTarget.dataset.createUrl, {
      map_name: this.tableTarget.dataset.mapCode || "",
      name: name.trim(),
    });
  }

  deletePlaylist(playlist) {
    submitPostForm(
      playlist.deleteUrl,
      {},
      {
        confirm: playlist.deleteConfirm,
        confirmTitle: "Delete playlist?",
        confirmClass: "btn-error",
      },
    );
  }

  closeContextMenu() {
    if (!this.hasContextMenuTarget) return;

    this.contextMenuTarget.classList.add("hidden");
    this.contextMenuTarget.setAttribute("aria-hidden", "true");
  }

  documentClick(event) {
    if (this.hasContextMenuTarget && !this.contextMenuTarget.contains(event.target)) {
      this.closeContextMenu();
    }

    if (!this.pendingPlaylistAction) return;
    if (
      event.target.closest("#playlists-table") ||
      event.target.closest("#playlist-search") ||
      event.target.closest("#confirm-modal")
    ) {
      return;
    }

    if (event.target.closest(".utilizer-breadcrumb")) {
      removeSessionItem(playlistActionStorageKey);
      return;
    }

    this.clearPendingPlaylistAction();
  }

  documentKeydown(event) {
    if (event.key === "Escape") this.closeContextMenu();
  }
}
</file>

<file path="utilizer-ruby/lib/utilizer/web/assets/controllers/home_maps_controller.js">
import { Controller } from "https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3.2.2/+esm";
import { clearSearchInput, matchesSearch, searchTerms, setVisible } from "../lib/search.js";
import { readLocalJson, writeLocalJson } from "../lib/storage.js";

export default class extends Controller {
  static targets = ["card", "search", "modeToggle", "activeMapCodes"];

  connect() {
    this.hiddenMapsStorageKey = "utilizer:hidden-maps";
    this.mapMode = "active";
    this.hiddenMaps = new Set(readLocalJson(this.hiddenMapsStorageKey, []));
    this.activeRuntimeMapCode = null;

    this.applyMapMode();
    this.pollRuntimeState();
    this.runtimeInterval = window.setInterval(() => this.pollRuntimeState(), 2000);
  }

  disconnect() {
    if (this.runtimeInterval) window.clearInterval(this.runtimeInterval);
  }

  toggleMode() {
    this.mapMode = this.mapMode === "select" ? "active" : "select";
    this.applyMapMode();
  }

  search() {
    this.applyMapMode();
  }

  clearSearch(event) {
    if (event.key !== "Escape" || !clearSearchInput(this.searchTarget)) return;

    event.preventDefault();
    this.applyMapMode();
  }

  openMap(event) {
    if (this.mapMode !== "select") return;

    event.preventDefault();
    this.toggleMapSelection(event.currentTarget.closest("[data-map-card]"));
  }

  toggleMap(event) {
    this.toggleMapSelection(event.currentTarget.closest("[data-map-card]"));
  }

  toggleMapSelection(card) {
    const code = card?.dataset.mapCode || "";
    if (!code) return;

    if (this.hiddenMaps.has(code)) {
      this.hiddenMaps.delete(code);
    } else {
      this.hiddenMaps.add(code);
    }
    writeLocalJson(this.hiddenMapsStorageKey, Array.from(this.hiddenMaps).sort());
    this.updateActiveMapCodesInput();
    this.applyMapMode();
  }

  activeMapCodes() {
    return this.cardTargets
      .map((card) => card.dataset.mapCode || "")
      .filter((code) => code && !this.hiddenMaps.has(code));
  }

  updateActiveMapCodesInput() {
    if (this.hasActiveMapCodesTarget) {
      this.activeMapCodesTarget.value = this.activeMapCodes().join(",");
    }
  }

  markActiveRuntimeMap(mapCode) {
    if (mapCode === this.activeRuntimeMapCode) return;

    this.activeRuntimeMapCode = mapCode;
    this.cardTargets.forEach((card) => {
      card.dataset.runtimeActiveMap =
        mapCode && card.dataset.mapCode === mapCode ? "true" : "false";
    });
  }

  applyMapMode() {
    const terms = searchTerms(this.hasSearchTarget ? this.searchTarget.value : "");
    document.body.dataset.mapMode = this.mapMode;
    this.updateActiveMapCodesInput();

    this.cardTargets.forEach((card) => {
      const code = card.dataset.mapCode || "";
      const hidden = this.hiddenMaps.has(code);
      const show =
        matchesSearch(card.dataset.mapSearchName || "", terms) &&
        (this.mapMode === "select" || !hidden);
      const toggle = card.querySelector("[data-toggle-map-visibility]");

      card.dataset.mapHidden = hidden ? "true" : "false";
      setVisible(card, show);

      if (toggle) {
        toggle.textContent = hidden ? "Inactive" : "Active";
        toggle.title = hidden ? "Activate map" : "Deactivate map";
        toggle.setAttribute("aria-label", toggle.title);
      }
    });

    if (this.hasModeToggleTarget) {
      const selectMode = this.mapMode === "select";
      this.modeToggleTarget.textContent = selectMode ? "DONE" : "MAPS";
      this.modeToggleTarget.title = selectMode ? "Finish selection" : "Select maps";
      this.modeToggleTarget.setAttribute("aria-label", this.modeToggleTarget.title);
    }
  }

  async pollRuntimeState() {
    try {
      const response = await fetch("/runtime/state");
      const data = await response.json();
      if (!data.ok) {
        this.markActiveRuntimeMap(null);
        return;
      }

      this.markActiveRuntimeMap(data.selected_playlist?.map_code || null);
    } catch (e) {
      this.markActiveRuntimeMap(null);
    }
  }
}
