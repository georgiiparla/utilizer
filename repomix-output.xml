<file path="utilizer-ruby/lib/utilizer/web/assets/lib/links.js">
export const linkDisplayFor = (value) => {
  const val = String(value || "").trim();
  if (!val) return { display: "", href: "" };

  try {
    if (/^https?:\/\//i.test(val)) {
      const url = new URL(val);
      return {
        display: url.hostname.replace(/^www\./, ""),
        href: val,
      };
    }

    return {
      display: val.replace(/^(https?:\/\/)?(www\.)?/, "").split("/")[0],
      href: `https://${val}`,
    };
  } catch (e) {
    return {
      display: "Link",
      href: /^https?:\/\//i.test(val) ? val : `https://${val}`,
    };
  }
};
