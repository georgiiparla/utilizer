# frozen_string_literal: true

require "fileutils"

class Utilizer
  class ProcessLock
    class Busy < StandardError; end

    RETRY_INTERVAL_SECONDS = 0.05
    @mutexes = {}
    @mutexes_mutex = Mutex.new

    class << self
      def mutex_for(path)
        key = File.expand_path(path)
        @mutexes_mutex.synchronize do
          @mutexes[key] ||= Mutex.new
        end
      end
    end

    def initialize(path, busy_message:)
      @path = path
      @busy_message = busy_message
    end

    def synchronize(blocking: true, timeout: nil)
      deadline = timeout ? Time.now + timeout : nil
      mutex = self.class.mutex_for(@path)
      mutex_acquired = acquire_mutex(mutex, blocking:, deadline:)

      FileUtils.mkdir_p(File.dirname(@path))
      File.open(@path, File::RDWR | File::CREAT, 0o644) do |file|
        acquire_file(file, blocking:, deadline:)
        begin
          yield
        ensure
          file.flock(File::LOCK_UN)
        end
      end
    ensure
      mutex&.unlock if mutex_acquired
    end

    private

    def acquire_mutex(mutex, blocking:, deadline:)
      return true if mutex.try_lock
      raise Busy, @busy_message unless blocking

      loop do
        raise Busy, @busy_message if deadline && Time.now >= deadline
        return true if mutex.try_lock

        sleep RETRY_INTERVAL_SECONDS
      end
    end

    def acquire_file(file, blocking:, deadline:)
      if blocking && deadline.nil?
        file.flock(File::LOCK_EX)
        return
      end

      loop do
        return if file.flock(File::LOCK_EX | File::LOCK_NB)

        raise Busy, @busy_message if !blocking || (deadline && Time.now >= deadline)

        sleep RETRY_INTERVAL_SECONDS
      end
    end
  end
end
