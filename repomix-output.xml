# frozen_string_literal: true

require "digest"

class Utilizer
  module PlaylistAlias
    PRIMARY_PREFIX = "ut_"
    MAX_ALIAS_LENGTH = 31
    HASH_LENGTH = 6

    module_function

    def slug(name)
      name.to_s.downcase.gsub(/[^a-z0-9]+/, "_").gsub(/\A_+|_+\z/, "")
    end

    def primary(name, map_name = nil)
      alias_for(PRIMARY_PREFIX, scoped_slug(name, map_name))
    end

    def scoped_slug(name, map_name = nil)
      name_slug = slug(name)
      map_slug = slug(map_name)
      return name_slug if map_slug.empty?
      return name_slug if name_slug == map_slug || name_slug.start_with?("#{map_slug}_")

      "#{map_slug}_#{name_slug}"
    end

    def alias_for(prefix, slug)
      raise ArgumentError, "Playlist name cannot be used as an alias" if slug.empty?

      value = "#{prefix}#{slug}"
      return value if value.length <= MAX_ALIAS_LENGTH

      digest = Digest::SHA1.hexdigest(slug)[0, HASH_LENGTH]
      head_length = MAX_ALIAS_LENGTH - prefix.length - HASH_LENGTH - 1
      head = slug[0, head_length].to_s.gsub(/_+\z/, "")
      head = slug[0, head_length].to_s if head.empty?
      "#{prefix}#{head}_#{digest}"
    end
  end
end
