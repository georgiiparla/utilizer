# frozen_string_literal: true

require "cgi"
require "erb"
require "json"

class Utilizer
  module Web
    class Renderer
      TEMPLATE_DIR = File.expand_path("templates", __dir__)
      ASSET_DIR = File.expand_path("assets", __dir__)
      TEMPLATE_NAMES = %w[dashboard error home layout playlist stopped].freeze
      THEME_OPTIONS = [
        { value: "dim", label: "Dim" },
        { value: "night", label: "Night" },
        { value: "nord", label: "Nord" },
        { value: "retro", label: "Retro" }
      ].freeze
      DEFAULT_THEME = THEME_OPTIONS.first.fetch(:value)
      FIND_LINKS = [
        { name: "Jumpthrow", host: "jumpthrow.pro", url: "https://jumpthrow.pro/" },
        { name: "CSNades", host: "csnades.gg", url: "https://csnades.gg/" },
        { name: "CS2Util", host: "www.cs2util.com", url: "https://www.cs2util.com/" },
        { name: "CS2 Tricks", host: "www.cs2tricks.com", url: "https://www.cs2tricks.com/" },
        { name: "CS2 Nades", host: "cs2nades.gg", url: "https://cs2nades.gg/" }
      ].freeze

      def initialize(logo_available:, csrf_token:, auth_token:)
        @logo_available = logo_available
        @csrf_token = csrf_token
        @auth_token = auth_token
        @templates = TEMPLATE_NAMES.to_h { |name| [name, load_template(name)] }
      end

      def page(name, locals = {})
        merged = default_locals.merge(locals)
        merged[:title] ||= "Utilizer"
        content = @templates.fetch(name).result_with_hash(merged)
        @templates.fetch("layout").result_with_hash(merged.merge(content: content))
      end

      def asset(name)
        normalized = normalize_asset_name(name)
        return nil unless normalized

        load_asset(normalized)
      end

      private

      def load_template(name)
        ERB.new(File.read(File.join(TEMPLATE_DIR, "#{name}.erb"), encoding: "UTF-8"), trim_mode: "-")
      end

      def load_asset(name)
        path = File.expand_path(name, ASSET_DIR)
        File.file?(path) ? File.binread(path) : nil
      end

      def normalize_asset_name(name)
        normalized = name.to_s.tr("\\", "/")
        return nil if normalized.empty? || normalized.start_with?("/") || normalized.include?("\0")
        return nil if normalized.split("/").include?("..")

        path = File.expand_path(normalized, ASSET_DIR)
        return nil unless path == ASSET_DIR || path.start_with?("#{ASSET_DIR}#{File::SEPARATOR}")

        normalized
      end

      def default_locals
        {
          logo_available: @logo_available,
          current_theme: DEFAULT_THEME,
          default_theme: DEFAULT_THEME,
          theme_options: THEME_OPTIONS,
          theme_switcher: method(:theme_switcher),
          find_links_dropdown: method(:find_links_dropdown),
          section_bar: method(:section_bar),
          search_box: method(:search_box),
          notification_pill: method(:notification_pill),
          sync_fab: method(:sync_fab),
          context_menu_item: method(:context_menu_item),
          map_crumb: method(:map_crumb),
          json_script: method(:json_script),
          dashboard_playlist_data: method(:dashboard_playlist_data),
          playlist_spot_data: method(:playlist_spot_data),
          csrf_token: @csrf_token,
          auth_token: @auth_token,
          page_controller: nil,
          page_controller_values: {},
          controller_data_attributes: method(:controller_data_attributes),
          csrf_field: method(:csrf_field),
          notice: nil,
          h: method(:h),
          u: method(:u)
        }
      end

      def theme_switcher
        options = THEME_OPTIONS.map do |theme|
          value = h(theme.fetch(:value))
          label = h(theme.fetch(:label))

          <<~HTML
            <li>
              <button type="button" class="flex items-center px-3 py-2 text-sm text-base-content/85" data-theme-target="choice" data-theme-choice="#{value}" data-action="theme#choose" title="Use #{label} theme" aria-label="Use #{label} theme">
                #{label}
              </button>
            </li>
          HTML
        end.join

        <<~HTML
          <details class="dropdown dropdown-end" data-theme-switcher data-theme-target="switcher">
            <summary class="btn btn-ghost btn-sm text-base-content/60 hover:text-base-content" title="Theme" aria-label="Theme">THEME</summary>
            <ul class="menu menu-sm dropdown-content z-[40] mt-2 p-2 shadow bg-base-200 border border-base-300 w-32">
              #{options}
            </ul>
          </details>
        HTML
      end

      def search_box(id:, placeholder:, controller:, target: "search", action: nil)
        target_attribute = controller_target(controller, target)
        action_attribute = action ? %( data-action="#{h(action)}") : ""

        <<~HTML
          <label class="utilizer-search flex items-center gap-1.5 w-[min(18rem,48vw)] text-base-content/60">
            <i class="ph-bold ph-magnifying-glass text-xs shrink-0"></i>
            <input id="#{h(id)}" type="search" class="grow min-w-0 bg-transparent" placeholder="#{h(placeholder)}" autocomplete="off" spellcheck="false"#{target_attribute}#{action_attribute}>
          </label>
        HTML
      end

      def notification_pill(content, id: nil, hidden: false, controller: nil, target: nil)
        id_attribute = id ? %( id="#{h(id)}") : ""
        target_attribute = controller && target ? controller_target(controller, target) : ""
        classes = ["utilizer-notification-pill"]
        classes << "hidden" if hidden

        <<~HTML
          <div#{id_attribute} class="#{classes.join(" ")}" data-notification-bar#{target_attribute}>
            #{content}
          </div>
        HTML
      end

      def sync_fab(action:, fields:, confirm:, confirm_title:, confirm_action:, return_to:,
                   button_class: "btn-primary", form_attrs: "")
        form_attrs = form_attrs.to_s.strip
        form_attrs = form_attrs.empty? ? "" : " #{form_attrs}"

        <<~HTML
          <form action="#{h(action)}" method="post" class="utilizer-sync-fab-container" data-confirm="#{h(confirm)}" data-confirm-title="#{h(confirm_title)}" data-confirm-action="#{h(confirm_action)}"#{form_attrs}>
            #{csrf_field}
            #{fields}
            <input type="hidden" name="return_to" value="#{h(return_to)}">
            <button type="submit" class="utilizer-sync-fab btn #{h(button_class)} btn-square" title="Sync cfg files" aria-label="Sync cfg files">
              <i class="ph-bold ph-arrows-clockwise"></i>
            </button>
          </form>
        HTML
      end

      def context_menu_item(action:, icon:, label:, action_attribute:, danger: false, hidden: false, label_target: nil)
        classes = [
          hidden ? "hidden" : "flex",
          "items-center gap-2 w-full px-3 py-2 text-sm",
          danger ? "text-error" : "text-base-content/85",
          "hover:bg-base-300/50"
        ].join(" ")
        label_attribute = label_target ? %( data-#{h(label_target)}="#{h(label_target)}") : ""

        <<~HTML
          <button type="button" class="#{classes}" #{h(action_attribute)}="#{h(action)}" role="menuitem">
            <i class="ph-bold #{h(icon)} text-lg"></i>
            <span#{label_attribute}>#{h(label)}</span>
          </button>
        HTML
      end

      def map_crumb(map_name:, map_icon: nil, href: nil, attrs: "")
        icon = map_icon ? %(<img src="#{h(map_icon)}" alt="" class="utilizer-breadcrumb-logo" data-preload-image>) : ""
        body = <<~HTML
          #{icon}
          <span class="truncate">#{h(map_name)}</span>
        HTML

        if href
          %(<a href="#{h(href)}" class="hover:underline flex items-center gap-1.5 min-w-0" #{attrs}>#{body}</a>)
        else
          %(<span class="flex items-center gap-1.5 min-w-0" #{attrs}>#{body}</span>)
        end
      end

      def json_script(id, data)
        %(<script type="application/json" id="#{h(id)}">#{safe_json(data)}</script>)
      end

      def dashboard_playlist_data(playlists, map_name)
        playlists.map do |playlist|
          name = playlist[:name].to_s
          filename = playlist[:filename].to_s

          {
            name: name,
            slug: playlist[:slug].to_s,
            filename: filename,
            mapName: playlist[:map_name].to_s,
            searchText: "#{name} #{filename} #{playlist[:command_alias]}",
            commandAlias: playlist[:command_alias],
            spotsCount: playlist[:spots_count],
            spotsLabel: playlist[:spots_count].nil? ? "-" : playlist[:spots_count].to_s,
            error: playlist[:error],
            playlistUrl: "/maps/#{u(map_name)}/playlists/#{u(name)}",
            deleteUrl: "/maps/#{u(map_name)}/playlists/#{u(name)}/delete",
            deleteConfirm: "Delete #{filename}?"
          }
        end
      end

      def playlist_spot_data(rows)
        rows.each_with_index.to_a.reverse_each.map do |row, index|
          {
            id: "saved-#{index}",
            originalIndex: index,
            description: row.description.to_s,
            command: row.command.to_s,
            link: row.link.to_s,
            comment: row.comment.to_s,
            captureId: nil,
            deleted: false
          }
        end
      end

      def section_bar(breadcrumbs, left_tools: "", right_tools: "", left_attrs: "", id: nil,
                      border_class: "border-b border-base-300")
        left_attributes = left_attrs.to_s.strip
        left_attributes = left_attributes.empty? ? "" : " #{left_attributes}"
        id_attribute = id ? " id=\"#{h(id)}\"" : ""

        breadcrumbs = [breadcrumbs] unless breadcrumbs.is_a?(Array)

        rendered_breadcrumbs = breadcrumbs.map do |crumb|
          if crumb.is_a?(Hash)
            if crumb[:renameable]
              <<~HTML
                <span id="playlist-name-display" data-map-name="#{h(crumb[:map_name])}" class="cursor-pointer hover:bg-base-200/50 px-2.5 py-1 transition-all text-base font-semibold truncate min-w-0" title="Click to rename">#{h(crumb[:text])}</span>
                <input id="playlist-name-input" type="text" value="#{h(crumb[:text])}" class="hidden bg-base-200/60 border border-base-content/20 focus:border-base-content/40 font-semibold text-base text-base-content/70 px-2.5 py-1 focus:outline-none w-56" placeholder="Playlist name" autocomplete="off" spellcheck="false">
              HTML
            elsif crumb[:url]
              %(<a href="#{h(crumb[:url])}" class="hover:underline truncate">#{h(crumb[:text])}</a>)
            else
              h(crumb[:text])
            end
          else
            h(crumb)
          end
        end.join(" <span class=\"text-base-content/30 mx-1.5\">/</span> ")

        <<~HTML
          <div#{id_attribute} class="flex items-center justify-between gap-4 px-6 sm:px-8 min-h-16 py-3 shrink-0 #{border_class} bg-base-200/30">
            <div class="flex items-center gap-3 min-w-0"#{left_attributes}>
              <h2 class="utilizer-breadcrumb text-base font-semibold uppercase tracking-wider text-base-content/70 flex items-center gap-2 min-w-0">
                #{rendered_breadcrumbs}
              </h2>
              #{left_tools}
            </div>
            <div class="flex items-center gap-3 shrink-0">
              #{right_tools}
            </div>
          </div>
        HTML
      end

      def find_links_dropdown
        links = FIND_LINKS.map do |link|
          name = h(link.fetch(:name))
          host = h(link.fetch(:host))
          url = h(link.fetch(:url))
          icon = h(favicon_url(host))

          <<~HTML
            <li>
              <a href="#{url}" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 px-3 py-2 text-sm text-base-content/85">
                <img src="#{icon}" alt="" class="w-4 h-4 shrink-0" data-preload-image>
                <span>#{name}</span>
              </a>
            </li>
          HTML
        end.join
        icons = h(FIND_LINKS.map { |link| favicon_url(link.fetch(:host)) }.join(","))

        <<~HTML
          <details class="dropdown dropdown-end" data-preload-images="#{icons}">
            <summary class="btn btn-ghost btn-sm text-base-content/60 hover:text-base-content" title="Web lineup resources" aria-label="Web lineup resources">EXPLORE</summary>
            <ul class="menu menu-sm dropdown-content z-[40] mt-2 p-2 shadow bg-base-200 border border-base-300 w-44">
              #{links}
            </ul>
          </details>
        HTML
      end

      def csrf_field
        [
          %(<input type="hidden" name="csrf_token" value="#{h(@csrf_token)}">),
          %(<input type="hidden" name="token" value="#{h(@auth_token)}">)
        ].join
      end

      def controller_data_attributes(values)
        values.map do |name, value|
          %(data-#{h(name)}-value="#{h(value)}")
        end.join(" ")
      end

      def controller_target(controller, target)
        %( data-#{h(controller)}-target="#{h(target)}")
      end

      def safe_json(data)
        JSON.generate(data)
            .gsub("&", "\\u0026")
            .gsub("<", "\\u003c")
            .gsub(">", "\\u003e")
      end

      def favicon_url(host)
        "https://www.google.com/s2/favicons?domain=#{host}"
      end

      def h(value)
        CGI.escapeHTML(value.to_s)
      end

      def u(value)
        CGI.escape(value.to_s)
      end
    end
  end
end
</file>

