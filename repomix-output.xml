# frozen_string_literal: true

require "cgi"
require "json"
require "securerandom"
require "uri"

require_relative "cfg_sync"
require_relative "console_capture_importer"
require_relative "event_log"
require_relative "playlist_alias"
require_relative "playlist_document"
require_relative "playlists"
require_relative "web/renderer"

class Utilizer
  class WebApp
    LOGO_FILENAME = "logo.ico"
    MAX_PENDING_CAPTURES_PER_PLAYLIST = 50
    SLOW_REQUEST_MS = 1000
    TOKEN_COOKIE = "utilizer_token"
    CSRF_PARAM = "csrf_token"
    SECURITY_HEADERS = {
      "X-Content-Type-Options" => "nosniff",
      "Referrer-Policy" => "same-origin",
      "Content-Security-Policy" => [
        "default-src 'self'",
        "script-src 'self' https://cdn.tailwindcss.com https://cdn.jsdelivr.net",
        "style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net",
        "font-src 'self' https://cdn.jsdelivr.net data:",
        "img-src 'self' https: data:",
        "connect-src 'self'",
        "base-uri 'none'",
        "form-action 'self'",
        "frame-ancestors 'none'"
      ].join("; ")
    }.freeze

    def initialize(config, port:, token:, on_shutdown:, on_heartbeat: -> {})
      @config = config
      @port = port.to_i
      @token = token.to_s
      @csrf_token = SecureRandom.hex(32)
      @on_shutdown = on_shutdown
      @on_heartbeat = on_heartbeat
      @logo = load_logo
      @renderer = Web::Renderer.new(logo_available: !@logo.nil?, csrf_token: @csrf_token, auth_token: @token)
      @flash = nil
      @event_log = EventLog.new(@config.event_log_path)
      @playlist_write_mutex = Mutex.new
      @capture_mutex = Mutex.new
      @event_log.info("web_app_initialized", log: @event_log.path)
      reset_services
    end

    def call(request, response)
      started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      apply_security_headers(response)
      return redirect_after_token_cookie(request, response) if token_handoff_request?(request)
      return forbidden(response) unless authorized_request?(request, response)

      remember_token(response) if token_from_query?(request)

      route(request, response)
    rescue StandardError => e
      render_error(response, e, request)
    ensure
      log_request(request, response, started_at) if started_at
    end

    private

    def apply_security_headers(response)
      SECURITY_HEADERS.each { |key, value| response[key] = value }
    end

    def authorized_request?(request, _response)
      return true if request.request_method == "GET" && request.path == "/health"
      return forbidden_request(request, "host") unless allowed_host?(request)
      return forbidden_request(request, "token") unless token_valid?(request)
      return forbidden_request(request, "origin") unless same_origin_post?(request)
      return forbidden_request(request, "csrf") unless csrf_valid?(request)

      true
    end

    def forbidden_request(request, reason)
      @event_log.warn("request_forbidden", reason: reason, method: request.request_method, path: request.path)
      false
    end

    def token_handoff_request?(request)
      request.request_method == "GET" && request.path == "/" && token_from_query?(request)
    end

    def redirect_after_token_cookie(request, response)
      return forbidden(response) unless allowed_host?(request) && secure_compare(query_param(request, "token"),
                                                                                 @token)

      remember_token(response)
      redirect(response, "/")
    end

    def allowed_host?(request)
      allowed_hosts.include?(request["host"].to_s.downcase)
    end

    def allowed_hosts
      @allowed_hosts ||= ["127.0.0.1:#{@port}", "localhost:#{@port}", "[::1]:#{@port}"].freeze
    end

    def token_valid?(request)
      secure_compare(request_token(request), @token)
    end

    def request_token(request)
      query_token = query_param(request, "token")
      query_token.to_s.empty? ? token_cookie(request) : query_token
    end

    def token_from_query?(request)
      !query_param(request, "token").to_s.empty?
    end

    def token_cookie(request)
      Array(request.cookies).find { |cookie| cookie.name == TOKEN_COOKIE }&.value.to_s
    end

    def remember_token(response)
      response["Set-Cookie"] = "#{TOKEN_COOKIE}=#{@token}; Path=/; HttpOnly; SameSite=Strict"
    end

    def same_origin_post?(request)
      return true unless request.request_method == "POST"

      origin = request["origin"].to_s
      return same_origin_url?(origin) unless origin.empty? || origin == "null"

      referer = request["referer"].to_s
      referer.empty? || same_origin_url?(referer)
    end

    def same_origin_url?(value)
      uri = URI(value)
      uri.scheme == "http" && allowed_hosts.include?(host_port(uri.host, uri.port))
    rescue URI::InvalidURIError
      false
    end

    def host_port(host, port)
      normalized = host.to_s.downcase
      normalized = "[#{normalized}]" if normalized.include?(":") && !normalized.start_with?("[")
      "#{normalized}:#{port}"
    end

    def csrf_valid?(request)
      return true unless request.request_method == "POST"
      return true if %w[/heartbeat /shutdown].include?(request.path)

      secure_compare(param(request, CSRF_PARAM), @csrf_token) ||
        secure_compare(request["x-csrf-token"].to_s, @csrf_token)
    end

    def secure_compare(left, right)
      left = left.to_s
      right = right.to_s
      return false if left.bytesize != right.bytesize

      left.bytes.zip(right.bytes).reduce(0) { |memo, (a, b)| memo | (a ^ b) }.zero?
    end

    def forbidden(response)
      response.status = 403
      text(response, "Forbidden")
    end

    def reset_services
      @playlists = Playlists.new(@config)
      @capture_mutex.synchronize do
        @capture_importer = ConsoleCaptureImporter.new(@config)
        @capture_queues = Hash.new { |queues, slug| queues[slug] = [] }
      end
    end

    def route(request, response)
      method = request.request_method
      path = request.path

      if method == "GET" && path == "/"
        render_home(response)
      elsif method == "GET" && (match = path.match(%r{\A/maps/([^/]+)\z}))
        render_dashboard(response, decode_path_segment(match[1]))
      elsif method == "GET" && path == "/health"
        text(response, "ok")
      elsif method == "POST" && path == "/heartbeat"
        heartbeat(response)
      elsif method == "GET" && path == "/assets/logo.ico"
        render_logo(response)
      elsif method == "GET" && path.start_with?("/assets/")
        render_asset(response, path.delete_prefix("/assets/"))
      elsif method == "POST" && path == "/shutdown"
        stop_server(response)
      elsif method == "POST" && (match = path.match(%r{\A/maps/([^/]+)/playlists/create\z}))
        create_playlist(request, response, decode_path_segment(match[1]))
      elsif method == "GET" && path == "/runtime/state"
        runtime_state(response)
      elsif method == "GET" && path == "/captures/latest"
        latest_capture(request, response)
      elsif method == "POST" && path == "/captures/clear"
        clear_capture(request, response)
      elsif method == "POST" && path == "/theme"
        update_theme(request, response)
      elsif method == "POST" && path == "/sync"
        sync_cfg(request, response)
      elsif (match = path.match(%r{\A/maps/([^/]+)/playlists/([^/]+)(?:/(delete|copy|rename))?\z}))
        route_playlist(method, decode_path_segment(match[1]), decode_path_segment(match[2]), match[3], request,
                       response)
      else
        response.status = 404
        response.body = "Not found"
      end
    end

    def route_playlist(method, map_code, name, action, request, response)
      if method == "GET" && action.nil?
        render_playlist(request, response, map_code, name)
      elsif method == "POST" && action.nil?
        save_playlist(request, response, map_code, name)
      elsif method == "POST" && action == "delete"
        delete_playlist(response, map_code, name)
      elsif method == "POST" && action == "copy"
        copy_spot_to_playlist(request, response, map_code, name)
      elsif method == "POST" && action == "rename"
        rename_playlist(request, response, map_code, name)
      else
        response.status = 404
        response.body = "Not found"
      end
    end

    def render_home(response)
      html(response, @renderer.page("home", maps: Maps.supported, current_theme: current_theme,
                                            notice: consume_notice, page_controller: "home-maps"))
    end

    def render_dashboard(response, map_name)
      playlists = dashboard_playlists.select do |playlist|
        map_name == "Uncategorized" ? playlist[:map_name].nil? || playlist[:map_name].empty? : playlist[:map_name] == map_name
      end
      map_data = Maps.supported.find { |m| m[:code] == map_name }
      html(response, @renderer.page("dashboard",
                                    config: @config.data,
                                    map_name: map_name,
                                    map_icon: map_data&.fetch(:icon),
                                    playlists: playlists,
                                    current_theme: current_theme,
                                    notice: consume_notice,
                                    page_controller: "dashboard-playlists"))
    end

    def render_playlist(_request, response, map_code, name)
      document = load_document(map_code, name)
      map_name = map_code || "Uncategorized"
      map_data = Maps.supported.find { |m| m[:code] == map_name }
      playlist_slug = PlaylistAlias.scoped_slug(document.name, Maps.alias_map(map_code))
      html(response, @renderer.page("playlist",
                                    title: "Utilizer - #{document.name}",
                                    document: document,
                                    map_name: map_name,
                                    map_icon: map_data&.fetch(:icon),
                                    rows: document.rows,
                                    playlist_slug: playlist_slug,
                                    current_theme: current_theme,
                                    notice: consume_notice,
                                    page_controller: "playlist-editor",
                                    page_controller_values: {
                                      "playlist-editor-map-code" => map_name,
                                      "playlist-editor-playlist-name" => document.name,
                                      "playlist-editor-playlist-slug" => playlist_slug
                                    }))
    end

    def create_playlist(request, response, map_code)
      name = param(request, "name").strip
      raise "Missing playlist name" if name.empty?

      path = @playlists.path_for(name, map_code: map_code, must_exist: false)
      created = PlaylistDocument.create(path)
      if created
        @event_log.info("playlist_created", name: name, path: path)
      else
        @event_log.info("playlist_open_existing", name: name, path: path)
      end
      message = created ? "Created #{File.basename(path)}." : "Opening existing #{File.basename(path)}."
      @flash = notice("success", message)
      redirect(response, playlist_url(map_code, File.basename(path, ".csv")))
    rescue StandardError => e
      @event_log.error("playlist_create_failed", name: param(request, "name"), message: e.message)
      @flash = notice("error", e.message)
      redirect(response, "/maps/#{CGI.escape(map_code.to_s)}")
    end

    def save_playlist(request, response, map_code, name)
      redirect_name = name
      sync_after_save = param(request, "save_action").strip == "sync"
      with_playlist_write_lock do
        document = load_document(map_code, name)
        redirect_name = document.name

        raw_new_name = param(request, "playlist_name").to_s.strip
        if !raw_new_name.empty? && raw_new_name != document.name
          new_path = @playlists.path_for(raw_new_name, map_code: map_code, must_exist: false)

          if File.exist?(new_path) && File.expand_path(new_path).downcase != File.expand_path(document.path).downcase
            raise "A playlist named '#{raw_new_name}' already exists."
          end

          if File.expand_path(new_path).downcase == File.expand_path(document.path).downcase
            temp_rename_path = "#{document.path}.rename_tmp"
            FileUtils.mv(document.path, temp_rename_path)
            FileUtils.mv(temp_rename_path, new_path)
          else
            FileUtils.mv(document.path, new_path)
          end

          document = load_document(map_code, raw_new_name)
          redirect_name = document.name
        end

        rows = extract_rows(request)
        content = document.content_for(rows)
        changed = document.save!(rows, content: content)
        clear_pending_captures(accepted_capture_ids(request))
        @event_log.info("playlist_saved", name: document.name, rows: rows.length,
                                          changed: changed)
        message = changed ? "Saved #{document.filename}." : "#{document.filename} is already current."
        flash_type = "success"
        if sync_after_save
          begin
            result = sync_playlist_after_save(map_code, document.name)
            message = "#{message} #{sync_message(result)}"
          rescue StandardError => e
            @event_log.error("playlist_sync_after_save_failed", name: document.name, message: e.message)
            message = "#{message} Sync failed: #{e.message}"
            flash_type = "error"
          end
        end
        @flash = notice(flash_type, message)
      end
      redirect(response, playlist_url(map_code, redirect_name))
    rescue StandardError => e
      @event_log.error("playlist_save_failed", name: name, message: e.message)
      action = sync_after_save ? "Save + sync" : "Save"
      @flash = notice("error", "#{action} failed: #{e.message}")
      redirect(response, playlist_url(map_code, redirect_name))
    end

    def rename_playlist(request, response, map_code, name)
      raw_new_name = param(request, "playlist_name").to_s.strip
      raise "Missing playlist name" if raw_new_name.empty?

      with_playlist_write_lock do
        document = load_document(map_code, name)
        if raw_new_name != document.name
          new_path = @playlists.path_for(raw_new_name, map_code: map_code, must_exist: false)
          if File.exist?(new_path) && File.expand_path(new_path).downcase != File.expand_path(document.path).downcase
            raise "A playlist named '#{raw_new_name}' already exists."
          end

          if File.expand_path(new_path).downcase == File.expand_path(document.path).downcase
            temp_rename_path = "#{document.path}.rename_tmp"
            FileUtils.mv(document.path, temp_rename_path)
            FileUtils.mv(temp_rename_path, new_path)
          else
            FileUtils.mv(document.path, new_path)
          end
        end

        renamed = load_document(map_code, raw_new_name)
        @event_log.info("playlist_renamed", from: name, to: renamed.name)
        json_response(response, ok: true, redirect: playlist_url(map_code, renamed.name))
      end
    rescue StandardError => e
      @event_log.error("playlist_rename_failed", name: name, message: e.message)
      json_response(response, ok: false, message: "Rename failed: #{e.message}")
    end

    def delete_playlist(response, map_code, name)
      with_playlist_write_lock do
        path = @playlists.path_for(name, map_code: map_code)
        filename = File.basename(path)
        FileUtils.rm_f(path)
        slug = PlaylistAlias.scoped_slug(File.basename(path, ".csv"), Maps.alias_map(map_code))
        clear_playlist_captures(slug)
        @event_log.info("playlist_deleted", name: name)
        message = "Deleted #{filename}."
        @flash = notice("success", message)
      end
      redirect(response, "/maps/#{CGI.escape(map_code.to_s)}")
    rescue StandardError => e
      @event_log.error("playlist_delete_failed", name: name, message: e.message)
      @flash = notice("error", "Delete failed: #{e.message}")
      redirect(response, "/maps/#{CGI.escape(map_code.to_s)}")
    end

    def sync_cfg(request, response)
      scope = param(request, "scope").strip
      scope = "all" if scope.empty?
      map_code = param(request, "map_code").strip
      map_codes = param(request, "map_codes").split(",").map(&:strip).reject(&:empty?)
      playlist_name = param(request, "playlist_name").strip

      result = run_sync(scope: scope, map_code: map_code, map_codes: map_codes, playlist_name: playlist_name)
      @flash = notice("success", sync_message(result))
    rescue StandardError => e
      @event_log.error("sync_failed", message: e.message)
      @flash = notice("error", "Sync failed: #{e.message}")
    ensure
      redirect(response, safe_return_to(param(request, "return_to")))
    end

    def sync_playlist_after_save(map_code, playlist_name)
      run_sync(scope: "playlist", map_code: map_code, playlist_name: playlist_name)
    end

    def run_sync(scope:, map_code: "", map_codes: [], playlist_name: "")
      result = CfgSync.new(@config, @playlists).run(scope: scope, map_code: map_code, map_codes: map_codes,
                                                    playlist_name: playlist_name)
      @event_log.info("sync_completed", playlists: result.playlist_count, spots: result.spot_count,
                                        skipped: result.skipped_row_count, release: result.generation_id,
                                        scope: scope)
      result
    end

    def sync_message(result)
      playlist_label = result.playlist_count == 1 ? "playlist" : "playlists"
      spot_label = result.spot_count == 1 ? "spot" : "spots"
      summary = [
        "Synced #{result.playlist_count} #{playlist_label}",
        "(#{result.spot_count} #{spot_label})",
        "(#{format_elapsed(result.elapsed_seconds)})"
      ].join(" ")
      parts = [summary]
      if result.skipped_row_count.to_i.positive?
        details = if result.skipped_reasons.is_a?(Array)
                    result.skipped_reasons.join("; ")
                  else
                    result.skipped_reasons.map do |reason, count|
                      "#{count} #{reason}"
                    end.join(", ")
                  end
        parts << "skipped #{result.skipped_row_count} rows (#{details})"
      end
      parts.concat(result.warnings.map { |warning| "warning: #{warning}" })
      "#{parts.join(". ")}."
    end

    def format_elapsed(seconds)
      format("%.1fs", seconds.to_f)
    end

    def latest_capture(request, response)
      playlist_slug = param(request, "playlist").strip
      captures = []
      pending = false
      @capture_mutex.synchronize do
        result = import_runtime_events
        pending = result.pending
        captures = @capture_queues.fetch(playlist_slug, []).map(&:dup) if valid_playlist_slug?(playlist_slug)
      end

      json_response(response,
                    ok: true,
                    capture: captures.last,
                    captures: captures,
                    pending: pending,
                    capture_command: "ut_save")
    rescue StandardError => e
      @event_log.error("capture_poll_failed", message: e.message)
      json_response(response, ok: false, capture: nil, captures: [], pending: false,
                              message: "Capture failed: #{e.message}")
    end

    def runtime_state(response)
      selected = nil
      pending = {}
      @capture_mutex.synchronize do
        result = import_runtime_events
        selected = selected_playlist(result.selected_playlist_slug)
        pending = pending_capture_counts
      end

      json_response(response, ok: true, selected_playlist: selected, pending_captures: pending)
    rescue StandardError => e
      @event_log.error("runtime_state_failed", message: e.message)
      json_response(response, ok: false, selected_playlist: nil, pending_captures: {},
                              message: "Runtime state failed: #{e.message}")
    end

    def clear_capture(request, response)
      id = param(request, "id").strip
      cleared = clear_pending_capture(id)
      json_response(response, ok: true, cleared: cleared)
    rescue StandardError => e
      @event_log.error("capture_clear_failed", message: e.message)
      json_response(response, ok: false, cleared: false, message: "Clear failed: #{e.message}")
    end

    def clear_pending_capture(id)
      clear_pending_captures([id])
    end

    def clear_pending_captures(ids)
      ids = ids.map(&:to_s).map(&:strip).reject(&:empty?).uniq
      return false if ids.empty?

      cleared = 0
      @capture_mutex.synchronize do
        @capture_queues.each_value do |queue|
          before = queue.length
          queue.reject! { |capture| ids.include?(capture[:id].to_s) }
          cleared += before - queue.length
        end
      end
      @event_log.info("capture_cleared", ids: ids, count: cleared) if cleared.positive?
      cleared.positive?
    end

    def clear_playlist_captures(slug)
      return false if slug.to_s.empty?

      cleared = 0
      @capture_mutex.synchronize do
        cleared = @capture_queues.delete(slug).to_a.length
      end
      @event_log.info("playlist_captures_cleared", slug: slug, count: cleared) if cleared.positive?
      cleared.positive?
    end

    def symbolize_capture(capture)
      {
        id: capture[:id] || capture["id"],
        playlist_slug: capture[:playlist_slug] || capture["playlist_slug"],
        command: capture[:command] || capture["command"],
        description: capture[:description] || capture["description"] || ""
      }
    end

    def import_runtime_events
      result = @capture_importer.import
      lookup = playlist_slug_lookup
      @capture_queues.clear if result.log_reset

      result.captures.each do |raw_capture|
        capture = symbolize_capture(raw_capture)
        slug = capture[:playlist_slug].to_s
        unless lookup.key?(slug)
          @event_log.info("capture_ignored", id: capture[:id], playlist_slug: slug,
                                             reason: "no selected playlist")
          next
        end

        queue = @capture_queues[slug]
        next if queue.any? { |pending_capture| pending_capture[:id].to_s == capture[:id].to_s }

        queue << capture
        queue.shift while queue.length > MAX_PENDING_CAPTURES_PER_PLAYLIST
        @event_log.info("capture_detected", id: capture[:id], playlist_slug: slug,
                                            command: capture[:command])
      end

      if result.selected_playlist_slug && !lookup.key?(result.selected_playlist_slug)
        @capture_importer.clear_selected_playlist(result.selected_playlist_slug)
      end

      prune_capture_queues(lookup)
      result
    end

    def selected_playlist(slug)
      playlist_slug_lookup[slug.to_s]
    end

    def valid_playlist_slug?(slug)
      playlist_slug_lookup.key?(slug.to_s)
    end

    def playlist_slug_lookup
      @playlists.entries.each_with_object({}) do |entry, lookup|
        slug = PlaylistAlias.scoped_slug(entry.name, Maps.alias_map(entry.map_code))
        next if slug.empty?

        lookup[slug] = { name: entry.name, slug: slug, map_code: entry.map_code }
      end
    end

    def prune_capture_queues(lookup)
      @capture_queues.each_key { |slug| @capture_queues.delete(slug) unless lookup.key?(slug) }
    end

    def pending_capture_counts
      by_playlist = @capture_queues.each_with_object({}) do |(slug, queue), counts|
        counts[slug] = queue.length if queue.any?
      end
      {
        total: by_playlist.values.sum,
        by_playlist: by_playlist
      }
    end

    def accepted_capture_ids(request)
      [param(request, "accepted_capture_ids"), param(request, "accepted_capture_id")]
        .join(",")
        .split(/[,\s]+/)
        .map(&:strip)
        .reject(&:empty?)
        .uniq
    end

    def update_theme(request, response)
      theme = param(request, "theme").strip
      unless valid_theme?(theme)
        response.status = 422
        return json_response(response, ok: false, message: "Unknown theme")
      end

      @config.set_theme(theme)
      json_response(response, ok: true, theme: theme)
    end

    def copy_spot_to_playlist(request, response, map_code, source_name)
      target_name = param(request, "target").strip
      copied_spots = copy_spots_payload(request)
      raise "Missing target playlist" if target_name.empty?
      raise "Missing command" if copied_spots.empty?
      raise "Cannot copy a spot into the same playlist" if target_name == source_name

      with_playlist_write_lock do
        target = load_document(map_code, target_name)
        rows = target.rows.map { |row| { command: row.command, description: row.description, link: row.link } }
        rows.concat(copied_spots)
        content = target.content_for(rows)
        target.save!(rows, content: content)
        source = load_document(map_code, source_name)
        spot_label = copied_spots.length == 1 ? "spot" : "#{copied_spots.length} spots"
        message = "Copied #{spot_label} from #{source.filename} to #{target.filename}."
        @event_log.info("spot_copied_to_playlist", source: source_name, target: target.name, count: copied_spots.length)
        json_response(response,
                      ok: true,
                      message: message,
                      target_filename: target.filename,
                      target_url: playlist_url(map_code, target.name),
                      spots_count: rows.length)
      end
    rescue StandardError => e
      @event_log.error("spot_copy_failed", source: source_name, message: e.message)
      json_response(response, ok: false, message: "Copy failed: #{e.message}")
    end

    def copy_spots_payload(request)
      raw_spots = param(request, "spots").strip
      spots = if raw_spots.empty?
                [{
                  command: param(request, "command").strip,
                  description: param(request, "description").strip,
                  link: param(request, "link").strip
                }]
              else
                JSON.parse(raw_spots).map do |spot|
                  {
                    command: spot.fetch("command", "").to_s.strip,
                    description: spot.fetch("description", "").to_s.strip,
                    link: spot.fetch("link", "").to_s.strip
                  }
                end
              end

      spots.reject { |spot| spot.fetch(:command).empty? }
    rescue JSON::ParserError
      raise "Invalid selected spots"
    end

    def stop_server(response)
      html(response, @renderer.page("stopped", current_theme: current_theme))
      response["Connection"] = "close"
      @on_shutdown.call
    end

    def heartbeat(response)
      @on_heartbeat.call
      text(response, "ok")
    end

    def render_asset(response, name)
      content_type = asset_content_type(name)
      unless content_type
        asset_missing(response, "/assets/#{name}")
        return
      end

      body = @renderer.asset(name)
      unless body
        @event_log.warn("asset_missing", path: "/assets/#{name}")
        response.status = 404
        response.body = "Not found"
        return
      end

      response["Content-Type"] = content_type
      response.body = body
    end

    def asset_content_type(name)
      case File.extname(name.to_s).downcase
      when ".css"
        "text/css; charset=utf-8"
      when ".js"
        "application/javascript; charset=utf-8"
      end
    end

    def render_logo(response)
      unless @logo
        response.status = 404
        response.body = "Not found"
        return
      end

      response["Content-Type"] = "image/x-icon"
      response.body = @logo
    end

    def asset_missing(response, path)
      @event_log.warn("asset_missing", path: path)
      response.status = 404
      response.body = "Not found"
    end

    def render_error(response, error, request = nil)
      @event_log.error("request_failed",
                       method: request&.request_method,
                       path: request&.path,
                       status: 500,
                       type: error.class.name,
                       message: error.message)
      response.status = 500
      html(response, @renderer.page("error", message: error.message, current_theme: current_theme))
    end

    def log_request(request, response, started_at)
      duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at) * 1000).round
      status = response_status(response)
      attrs = {
        method: request.request_method,
        path: request.path,
        status: status,
        duration_ms: duration_ms
      }

      if status == 404
        @event_log.warn("request_not_found", **attrs)
      elsif duration_ms >= SLOW_REQUEST_MS
        @event_log.warn("request_slow", **attrs)
      end
    rescue StandardError
      nil
    end

    def response_status(response)
      status = response.status.to_i
      status.positive? ? status : 200
    end

    def dashboard_playlists
      @playlists.entries.map do |entry|
        document = PlaylistDocument.load(entry.path)
        map_name = entry.map_code
        {
          name: document.name,
          slug: PlaylistAlias.scoped_slug(document.name, Maps.alias_map(map_name)),
          filename: document.filename,
          path: document.path,
          command_alias: playlist_command_alias(document.name, map_name),
          spots_count: document.rows.length,
          map_name: map_name
        }
      rescue StandardError => e
        name = entry.name
        {
          name: name,
          slug: PlaylistAlias.scoped_slug(name, Maps.alias_map(entry.map_code)),
          filename: entry.filename,
          path: entry.path,
          command_alias: playlist_command_alias(name),
          spots_count: nil,
          map_name: entry.map_code,
          error: e.message
        }
      end
    end

    def load_document(map_code, name)
      PlaylistDocument.load(@playlists.path_for(name, map_code: map_code))
    end

    def extract_rows(request)
      count = param(request, "row_count").to_i
      (0...count).map do |index|
        {
          command: param(request, "command_#{index}"),
          description: param(request, "description_#{index}"),
          link: param(request, "link_#{index}"),
          comment: param(request, "comment_#{index}")
        }
      end
    end

    def folder_playlists(map_name)
      dashboard_playlists.select { |playlist| playlist[:map_name] == map_name }
    end

    def playlist_command_alias(name, map_name = nil)
      "exec #{PlaylistAlias.primary(name, map_name)}"
    rescue ArgumentError
      nil
    end

    def current_theme
      theme = @config.data["theme"].to_s
      theme = "night" if theme == "black"
      valid_theme?(theme) ? theme : Web::Renderer::DEFAULT_THEME
    rescue StandardError
      Web::Renderer::DEFAULT_THEME
    end

    def valid_theme?(theme)
      Web::Renderer::THEME_OPTIONS.any? { |option| option.fetch(:value) == theme }
    end

    def html(response, body)
      response["Content-Type"] = "text/html; charset=utf-8"
      response.body = body
    end

    def text(response, body)
      response["Content-Type"] = "text/plain; charset=utf-8"
      response.body = body
    end

    def json_response(response, payload)
      response["Content-Type"] = "application/json; charset=utf-8"
      response.body = JSON.generate(payload)
    end

    def redirect(response, location)
      response.status = 303
      response["Location"] = location
      response.body = ""
    end

    def notice(type, text)
      { type: type, text: text }
    end

    def with_playlist_write_lock(&)
      @playlist_write_mutex.synchronize(&)
    end

    def consume_notice
      notice = @flash
      @flash = nil
      notice
    end

    def safe_return_to(value)
      value = value.to_s
      return value if value.start_with?("/") && !value.start_with?("//")

      "/"
    end

    def playlist_url(map_code, name)
      "/maps/#{CGI.escape(map_code.to_s)}/playlists/#{CGI.escape(name.to_s)}"
    end

    def decode_path_segment(value)
      CGI.unescape(value.to_s)
    end

    def query_param(request, name)
      value = request.query[name]
      return utf8(value) unless value.to_s.empty?

      query_string = request.respond_to?(:query_string) ? request.query_string.to_s : ""
      pair = URI.decode_www_form(query_string).find { |key, _| key == name }
      utf8(pair&.last)
    rescue ArgumentError
      ""
    end

    def param(request, name)
      utf8(request.query[name])
    end

    def utf8(value)
      text = value.to_s.dup
      text.force_encoding(Encoding::UTF_8)
      return text if text.valid_encoding?

      text.encode(Encoding::UTF_8, invalid: :replace, undef: :replace, replace: "")
    end

    def logo_path
      @logo_path ||= begin
        exe_dir = ENV.fetch("AIBIKA_EXECUTABLE", nil) && File.dirname(ENV.fetch("AIBIKA_EXECUTABLE", nil))
        candidates = [
          exe_dir && File.join(exe_dir, LOGO_FILENAME),
          File.expand_path("../../logo.ico", __dir__),
          File.expand_path(LOGO_FILENAME, Dir.pwd),
          File.expand_path(LOGO_FILENAME, File.dirname($PROGRAM_NAME))
        ].compact

        candidates.find { |path| File.file?(path) }
      end
    end

    def load_logo
      path = logo_path
      File.binread(path) if path
    end
  end
end
