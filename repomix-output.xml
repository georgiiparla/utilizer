[Code]
var
  CS2Page: TInputDirWizardPage;
  LaunchOptionsPage: TOutputMsgMemoWizardPage;

function NormalizePath(Path: string): string;
begin
  Result := Trim(Path);
  if (Length(Result) >= 2) and
     (((Copy(Result, 1, 1) = '"') and (Copy(Result, Length(Result), 1) = '"')) or
      ((Copy(Result, 1, 1) = '''') and (Copy(Result, Length(Result), 1) = ''''))) then
    Result := Copy(Result, 2, Length(Result) - 2);

  StringChangeEx(Result, '/', '\', True);
  while (Length(Result) > 3) and (Copy(Result, Length(Result), 1) = '\') do
    Result := Copy(Result, 1, Length(Result) - 1);
end;

function JsonEscape(Value: string): string;
begin
  Result := Value;
  StringChangeEx(Result, '\', '\\', True);
  StringChangeEx(Result, '"', '\"', True);
end;

function EndsWithText(Value: string; Suffix: string): Boolean;
var
  NormalizedValue: string;
  NormalizedSuffix: string;
begin
  NormalizedValue := Lowercase(Value);
  NormalizedSuffix := Lowercase(Suffix);
  Result := (Length(NormalizedValue) >= Length(NormalizedSuffix)) and
    (Copy(NormalizedValue, Length(NormalizedValue) - Length(NormalizedSuffix) + 1, Length(NormalizedSuffix)) = NormalizedSuffix);
end;

function CS2CfgPath(InstallRoot: string): string;
begin
  Result := NormalizePath(InstallRoot) + '\game\csgo\cfg';
end;

function CS2InstallRootValidationError(InstallRoot: string): string;
var
  Root: string;
begin
  Root := NormalizePath(InstallRoot);
  if Root = '' then
  begin
    Result := 'Select your Counter-Strike 2 install folder. In Steam, use Manage > Browse local files and select the Counter-Strike Global Offensive folder.';
    exit;
  end;

  if not DirExists(Root) then
  begin
    Result := 'The selected folder does not exist: ' + Root;
    exit;
  end;

  if not EndsWithText(Root, '\steamapps\common\Counter-Strike Global Offensive') then
  begin
    Result := 'Select the Counter-Strike Global Offensive folder inside a Steam library, for example:' + #13#10 +
      '...\steamapps\common\Counter-Strike Global Offensive';
    exit;
  end;

  if not FileExists(Root + '\game\bin\win64\cs2.exe') then
  begin
    Result := 'The selected folder does not look like a current Counter-Strike 2 install because game\bin\win64\cs2.exe was not found.';
    exit;
  end;

  if not DirExists(CS2CfgPath(Root)) then
  begin
    Result := 'The selected folder does not contain the expected CS2 cfg folder: ' + CS2CfgPath(Root);
    exit;
  end;

  Result := '';
end;

procedure InitializeWizard;
begin
  CS2Page := CreateInputDirPage(
    wpSelectDir,
    'Counter-Strike 2 Configuration',
    'Where is your Counter-Strike 2 install folder?',
    'In Steam, open Counter-Strike 2 > Manage > Browse local files, then select the Counter-Strike Global Offensive folder.',
    False,
    ''
  );
  CS2Page.Add('');

  LaunchOptionsPage := CreateOutputMsgMemoPage(
    CS2Page.ID,
    'Utilizer Local App',
    'Utilizer runs as a local tray app and opens in your browser.',
    'Use the tray icon if you need to open Utilizer again or copy a browser login link:',
    'http://127.0.0.1:47825/' + #13#10 + #13#10 +
    'For Steam browser, choose Copy Login Link from the tray and paste it once.' + #13#10 +
    'After that, the local URL can be bookmarked in that browser.' + #13#10 + #13#10 +
    'The tray icon can also reopen the browser or stop the local app.' + #13#10 + #13#10 +
    'For CS2 captures, keep these Steam launch options:' + #13#10 +
    '-condebug -conclearlog'
  );
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  ErrorMessage: string;
begin
  Result := True;
  if CurPageID = CS2Page.ID then
  begin
    ErrorMessage := CS2InstallRootValidationError(CS2Page.Values[0]);
    if ErrorMessage <> '' then
    begin
      MsgBox(ErrorMessage, mbError, MB_OK);
      Result := False;
    end;
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ConfigDir: string;
  ConfigPath: string;
  CfgPath: string;
  JsonContent: string;
begin
  if CurStep = ssPostInstall then
  begin
    ConfigDir := ExpandConstant('{userappdata}\Utilizer');
    ConfigPath := ConfigDir + '\config.json';
    CfgPath := CS2CfgPath(CS2Page.Values[0]);

    ForceDirectories(ConfigDir);
    ForceDirectories(ConfigDir + '\playlists');
    ForceDirectories(ConfigDir + '\runtime');

    JsonContent := '{' + #13#10 +
      '  "csgo_cfg_folder": "' + JsonEscape(CfgPath) + '"' + #13#10 +
      '}';

    SaveStringToFile(ConfigPath, JsonContent, False);
  end;
end;
</file>

