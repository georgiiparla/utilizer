# frozen_string_literal: true

require "fileutils"

class Utilizer
  class RuntimeGates
    GENERATED_HEADER = "// Generated by Utilizer. Do not edit."
    ACTIONS = {
      "rightarrow" => { alias: "ut_arrow_right", action: "right" },
      "leftarrow" => { alias: "ut_arrow_left", action: "left" },
      "uparrow" => { alias: "ut_arrow_up", action: "up" },
      "downarrow" => { alias: "ut_arrow_down", action: "down" }
    }.freeze

    def self.restore(config)
      write_gate_files(config, active: true)
    end

    def self.clear(config)
      write_gate_files(config, active: false)
    end

    def self.aliases
      ACTIONS.values.map { |action| action.fetch(:alias) }
    end

    def self.runtime_gate_path(action)
      "console_utilizer/runtime/#{action.fetch(:action)}"
    end

    def self.runtime_gate_file(csgo_cfg_folder, action)
      File.join(csgo_cfg_folder, "console_utilizer", "runtime", "#{action.fetch(:action)}.cfg")
    end

    def self.write_gate_files(config, active:)
      csgo_cfg_folder = config.data["csgo_cfg_folder"]
      return 0 unless Dir.exist?(csgo_cfg_folder)

      ACTIONS.values.count do |action|
        lines = active ? [action.fetch(:alias)] : []
        write_generated_file(csgo_cfg_folder, runtime_gate_file(csgo_cfg_folder, action), cfg_content(lines))
      end
    end
    private_class_method :write_gate_files

    def self.write_generated_file(csgo_cfg_folder, path, content)
      assert_inside_cfg!(csgo_cfg_folder, path)
      raise "Refusing to overwrite non-Utilizer cfg file: #{path}" if File.file?(path) && !generated_file?(path)

      FileUtils.mkdir_p(File.dirname(path))
      return false if File.file?(path) && File.read(path, encoding: "UTF-8") == content

      File.write(path, content, encoding: "UTF-8")
      true
    end
    private_class_method :write_generated_file

    def self.cfg_content(lines)
      "#{([GENERATED_HEADER] + lines).join("\n")}\n"
    end
    private_class_method :cfg_content

    def self.generated_file?(path)
      File.open(path, "r:UTF-8") { |file| file.readline.chomp == GENERATED_HEADER }
    rescue EOFError, SystemCallError
      false
    end
    private_class_method :generated_file?

    def self.assert_inside_cfg!(csgo_cfg_folder, path)
      target = clean_path(File.expand_path(path))
      root = clean_path(File.expand_path(csgo_cfg_folder))
      return if target.start_with?("#{root}/")

      raise "Refusing to write outside CS2 cfg folder: #{target}"
    end
    private_class_method :assert_inside_cfg!

    def self.clean_path(path)
      path.tr('\\', "/")
    end
    private_class_method :clean_path
  end
end
