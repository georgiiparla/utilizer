# frozen_string_literal: true

require "securerandom"
require "time"

require_relative "capture_protocol"
require_relative "path_normalizer"

class Utilizer
  class ConsoleCaptureImporter
    Result = Struct.new(:captures, :cancels, :pending, :selected_playlist_slug, :log_reset, keyword_init: true)

    COORD_LINE = /\b(setpos\s+[^;]+;\s*setang\s+\S+\s+\S+\s+\S+)/
    PLAYLIST_LINE = /#{Regexp.escape(CaptureProtocol::PLAYLIST_MARKER)}\s+([a-z0-9_]+)/

    def initialize(config)
      @config = config
      @log_path = configured_console_log_path
      @offset = current_size
      @pending_marker = false
      @selected_playlist_slug = nil
      @sequence = 0
    end

    def import
      raise @config_error if @config_error
      unless File.exist?(@log_path)
        raise "console.log not found at #{@log_path}. Launch CS2 once with -condebug -conclearlog to enable captures."
      end

      captures = []
      lines = read_new_lines
      log_reset = @log_reset
      lines.each do |line|
        capture = process_line(line)
        captures << capture if capture
      end

      Result.new(
        captures: captures,
        cancels: 0,
        pending: @pending_marker,
        selected_playlist_slug: @selected_playlist_slug,
        log_reset: log_reset
      )
    end

    def clear_selected_playlist(slug = nil)
      return if slug && @selected_playlist_slug != slug

      @selected_playlist_slug = nil
    end

    private

    def configured_console_log_path
      cfg_folder = PathNormalizer.normalize_cs2_cfg(@config.data["csgo_cfg_folder"])
      if cfg_folder.empty?
        @config_error = not_configured_message
        return ""
      end

      unless PathNormalizer.cs2_cfg_shape?(cfg_folder)
        @config_error = "CS2 cfg folder must end with game/csgo/cfg: #{cfg_folder}"
        return ""
      end

      unless Dir.exist?(cfg_folder)
        @config_error = "CS2 cfg folder not found: #{cfg_folder}"
        return ""
      end

      @config_error = nil
      File.join(PathNormalizer.cs2_game_folder(cfg_folder), "console.log")
    rescue SystemCallError => e
      @config_error = "CS2 cfg folder is not usable: #{e.message}"
      ""
    end

    def not_configured_message
      path = @config.respond_to?(:path) ? @config.path : "config.json"
      "CS2 cfg folder is not configured. Reinstall Utilizer or edit #{path}."
    end

    def read_new_lines
      size = File.size(@log_path)
      @log_reset = size < @offset
      if @log_reset
        @offset = 0
        @pending_marker = false
        @selected_playlist_slug = nil
      end

      File.open(@log_path, "rb") do |file|
        file.seek(@offset)
        content = file.read.to_s
        @offset = file.pos
        content.encode("UTF-8", invalid: :replace, undef: :replace, replace: "").lines.map(&:strip)
      end
    end

    def process_line(line)
      playlist = line.match(PLAYLIST_LINE)
      if playlist
        @selected_playlist_slug = playlist[1]
        return nil
      end

      if line.include?(CaptureProtocol::CAPTURE_MARKER)
        @pending_marker = true
        return nil
      end

      return nil unless @pending_marker

      match = line.match(COORD_LINE)
      return nil unless match

      @pending_marker = false
      {
        id: next_capture_id,
        playlist_slug: @selected_playlist_slug,
        command: normalize_command(match[1]),
        description: ""
      }
    end

    def next_capture_id
      @sequence += 1
      "#{Time.now.utc.strftime("%Y%m%d%H%M%S")}-#{@sequence}-#{SecureRandom.hex(4)}"
    end

    def normalize_command(command)
      command.gsub(/\s*;\s*/, ";").strip
    end

    def current_size
      return 0 if @log_path.to_s.empty?

      File.exist?(@log_path) ? File.size(@log_path) : 0
    end
  end
end
