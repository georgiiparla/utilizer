<file path="utilizer-ruby/lib/utilizer/web/assets/lib/http.js">
export const postFetch = (url, params = {}, options = {}) => {
  const body =
    params instanceof URLSearchParams
      ? new URLSearchParams(params)
      : new URLSearchParams(params);
  const headers = { ...(options.headers || {}) };
  const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
  const authToken = document.querySelector('meta[name="auth-token"]')?.content;

  if (csrfToken) headers["X-CSRF-Token"] = csrfToken;
  const target = new URL(url, window.location.href);
  if (authToken) {
    body.set("token", authToken);
    target.searchParams.set("token", authToken);
  }

  return fetch(target.toString(), {
    ...options,
    method: "POST",
    headers,
    body,
  });
};
</file>

