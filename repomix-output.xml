# frozen_string_literal: true

require "fileutils"
require "net/http"
require "rbconfig"
require "securerandom"
require "socket"
require "time"

require_relative "process_lock"
require_relative "web_registry"

class Utilizer
  class WebLauncher
    PORT = 47_825
    HOST = "127.0.0.1"
    URL = "http://#{HOST}:#{PORT}/".freeze
    STARTUP_HEALTH_TIMEOUT_SECONDS = 20

    def initialize(config)
      @config = config
      @registry = WebRegistry.new(config)
    end

    def open
      ensure_server(open_browser: true)
    end

    def ensure_server(open_browser: true)
      ProcessLock.new(
        @config.web_launch_lock_path,
        busy_message: "Utilizer is already starting. Try again in a moment."
      ).synchronize(timeout: 15) do
        ensure_server_unlocked(open_browser:)
      end
    end

    def stop
      record = @registry.active
      unless server_running?
        if port_available?
          @registry.clear
          puts "Utilizer web app is not running."
          return
        end

        raise "Utilizer web app is not responding, but #{HOST}:#{PORT} is still in use."
      end

      stop_server(record ? browser_url(record) : URL)
      stop_registered_process(record) unless wait_for_stopped

      raise "Utilizer web app did not stop. #{HOST}:#{PORT} is still in use." unless wait_for_stopped

      @registry.clear
      puts "Utilizer web app stopped."
    end

    def restart(open_browser: true)
      stop if server_running? || !port_available?
      ensure_server(open_browser:)
    end

    def server_running?
      healthy_url?(URL)
    end

    def status
      return "running" if server_running?
      return "port busy" unless port_available?

      "stopped"
    end

    def stop_server(url = URL)
      uri = URI(url)
      uri.path = "/shutdown"
      uri.query = token_query_for(url)
      http = Net::HTTP.new(uri.host, uri.port)
      http.open_timeout = 0.5
      http.read_timeout = 0.5
      http.post(uri.request_uri, "")
      true
    rescue IOError, SystemCallError, Timeout::Error, URI::InvalidURIError
      false
    end

    def heartbeat
      uri = URI(URL)
      uri.path = "/heartbeat"
      record = @registry.active
      uri.query = record ? token_query_for(record.fetch("url", URL), record["token"]) : nil
      http = Net::HTTP.new(uri.host, uri.port)
      http.open_timeout = 0.5
      http.read_timeout = 0.5
      http.post(uri.request_uri, "")
      true
    rescue IOError, SystemCallError, Timeout::Error, URI::InvalidURIError
      false
    end

    def open_browser(url = URL)
      return if ENV["UTILIZER_OPEN_BROWSER"] == "0"

      if Gem.win_platform?
        system("cmd", "/c", "start", "", url)
      else
        system("open", url) || system("xdg-open", url)
      end
    end

    private

    def ensure_server_unlocked(open_browser:)
      record = @registry.active
      if record && record["port"].to_i == PORT
        open_browser(browser_url(record)) if open_browser
        puts "Utilizer web app already open: #{record.fetch("url", URL)}"
        return record
      elsif record
        stop_server(browser_url(record))
      end

      if server_running?
        open_browser(URL) if open_browser
        puts "Utilizer web app already open: #{URL}"
        return { "url" => URL, "port" => PORT }
      end

      raise port_conflict_message unless port_available?

      token = @config.respond_to?(:auth_token) ? @config.auth_token : SecureRandom.hex(32)
      log = open_log
      pid = start_process(log, token)
      log.close

      @registry.write(
        "pid" => pid,
        "url" => URL,
        "token" => token,
        "port" => PORT,
        "started_at" => Time.now.utc.iso8601
      )

      raise "Utilizer web app did not start." unless wait_for_server

      launch_url = browser_url("url" => URL, "token" => token)
      open_browser(launch_url) if open_browser
      puts "Utilizer web app: #{launch_url}"
      puts "Log: #{@config.web_log_path}"
      puts "Stop: ruby main.rb #{Utilizer::DEV_STOP_COMMAND}" unless packaged_executable?
      { "pid" => pid, "url" => URL, "token" => token, "port" => PORT }
    rescue StandardError
      log&.close
      raise
    end

    def server_command(port, token)
      if packaged_executable?
        [packaged_executable_path, Utilizer::INTERNAL_SERVER_COMMAND, port.to_s, token]
      else
        [RbConfig.ruby, File.join(project_root, "main.rb"), Utilizer::INTERNAL_SERVER_COMMAND, port.to_s, token]
      end
    end

    def start_process(log, token)
      pid = Process.spawn(*server_command(PORT, token), out: log, err: log, chdir: project_root, new_pgroup: true)
      Process.detach(pid)
      pid
    end

    def browser_url(record)
      url = record.fetch("url", URL)
      token = record["token"].to_s
      return url if token.empty?

      uri = URI(url)
      uri.query = token_query_for(url, token)
      uri.to_s
    end

    def token_query_for(url, token = nil)
      token ||= begin
        URI.decode_www_form(URI(url).query.to_s).assoc("token")&.last
      rescue URI::InvalidURIError
        nil
      end
      token.to_s.empty? ? nil : URI.encode_www_form("token" => token)
    end

    def packaged_executable?
      File.extname($PROGRAM_NAME).casecmp(".exe").zero?
    end

    def packaged_executable_path
      File.expand_path(ENV["AIBIKA_EXECUTABLE"] || $PROGRAM_NAME)
    end

    def project_root
      @project_root ||= if packaged_executable?
                          File.dirname(packaged_executable_path)
                        else
                          File.expand_path("../..",
                                           __dir__)
                        end
    end

    def port_available?
      server = TCPServer.new(HOST, PORT)
      true
    rescue SystemCallError
      false
    ensure
      server&.close
    end

    def open_log
      FileUtils.mkdir_p(File.dirname(@config.web_log_path))
      log = File.new(@config.web_log_path, "w")
      log.puts "#{Time.now.utc.iso8601} launcher starting web app"
      log.flush
      log
    end

    def wait_for_server
      deadline = Time.now + STARTUP_HEALTH_TIMEOUT_SECONDS

      until Time.now > deadline
        return true if server_running?

        sleep 0.1
      end

      false
    end

    def wait_for_stopped
      deadline = Time.now + 5

      until Time.now > deadline
        return true unless server_running? || !port_available?

        sleep 0.1
      end

      false
    end

    def stop_registered_process(record)
      pid = record && record["pid"].to_i
      return if pid.to_i <= 0

      return stop_registered_process_windows(pid) if Gem.win_platform?

      Process.kill("TERM", pid)
      sleep 0.5
      Process.kill("KILL", pid) unless wait_for_stopped
    rescue Errno::ESRCH, Errno::EINVAL
      nil
    end

    def stop_registered_process_windows(pid)
      system("taskkill", "/PID", pid.to_s, "/T", "/F", out: File::NULL, err: File::NULL)
      sleep 0.5
    end

    def healthy_url?(url)
      uri = URI(url)
      uri.path = "/health"
      uri.query = nil
      http = Net::HTTP.new(uri.host, uri.port)
      http.open_timeout = 0.2
      http.read_timeout = 0.2
      response = http.get(uri.request_uri)
      response.is_a?(Net::HTTPSuccess) && response.body.to_s.strip == "ok"
    rescue IOError, SystemCallError, Timeout::Error, URI::InvalidURIError
      false
    end

    def port_conflict_message
      "Utilizer cannot start because #{HOST}:#{PORT} is already in use by another process."
    end
  end
end
