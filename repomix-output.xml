# frozen_string_literal: true

class Utilizer
  module CommandValidator
    DANGEROUS_COMMANDS = %w[
      alias
      bind
      disconnect
      exec
      quit
      rcon
      unbind
    ].freeze

    module_function

    def normalize(command)
      validate!(command)
      statements(command).join("; ")
    end

    def valid?(command)
      skip_reason(command).nil?
    end

    def validate!(command)
      reason = skip_reason(command)
      raise ArgumentError, reason if reason

      true
    end

    def skip_reason(command)
      parsed = parsed_statements(command)
      return "missing command" if parsed.empty?
      return "dangerous console command" if parsed.any? { |statement| dangerous?(statement) }
      return "missing setpos command" unless parsed.any? { |statement| setpos?(statement) }
      return "missing setang command" unless parsed.any? { |statement| setang?(statement) }

      nil
    end

    def yaw(command)
      statement = parsed_statements(command).find { |candidate| setang?(candidate) }
      statement&.fetch(:args)&.[](1)
    end

    def statements(command)
      parsed_statements(command).map { |statement| statement.fetch(:text) }
    end

    def parsed_statements(command)
      split_statements(command).filter_map do |statement|
        text = normalize_statement(statement)
        next if text.empty?

        parts = split_words(text)
        next if parts.empty?

        { text: text, name: parts.first.downcase, args: parts.drop(1) }
      end
    end

    def split_statements(command)
      statements = []
      current = +""
      quote = nil

      command.to_s.each_char do |char|
        if quote
          quote = nil if char == quote
          current << char
        elsif ['"', "'"].include?(char)
          quote = char
          current << char
        elsif [";", "\n", "\r"].include?(char)
          statements << current
          current = +""
        else
          current << char
        end
      end

      statements << current
      statements
    end

    def split_words(statement)
      words = []
      current = +""
      quote = nil

      statement.each_char do |char|
        if quote
          if char == quote
            quote = nil
          else
            current << char
          end
        elsif ['"', "'"].include?(char)
          quote = char
        elsif char.match?(/\s/)
          unless current.empty?
            words << current
            current = +""
          end
        else
          current << char
        end
      end

      words << current unless current.empty?
      words
    end

    def normalize_statement(statement)
      statement.to_s.strip.gsub(/\s+/, " ")
    end

    def dangerous?(statement)
      DANGEROUS_COMMANDS.include?(statement.fetch(:name))
    end

    def setpos?(statement)
      statement.fetch(:name) == "setpos" && numeric_args?(statement, 3)
    end

    def setang?(statement)
      statement.fetch(:name) == "setang" && numeric_args?(statement, 2)
    end

    def numeric_args?(statement, minimum)
      args = statement.fetch(:args)
      args.length >= minimum && args.first(minimum).all? { |arg| number?(arg) }
    end

    def number?(value)
      Float(value)
      true
    rescue ArgumentError, TypeError
      false
    end
  end
end
