<file path="utilizer-ruby/native/utilizer-tray/main.go">
package main

import (
	"bytes"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"net"
	"net/http"
	"os"
	"os/exec"
	"path/filepath"
	"strings"
	"time"

	"github.com/getlantern/systray"
)

const (
	host       = "127.0.0.1"
	port       = 47825
	url        = "http://127.0.0.1:47825/"
	mutexName  = "Local\\UtilizerTray"
	logName    = "web.log"
	sidecarExe = "utilizer-web.exe"
)

var (
	ownedServerProcess        *serverProcess
	serverWasHealthy          bool
	stopRequested             bool
	consecutiveHealthFailures int
	httpClient                = &http.Client{Timeout: 1500 * time.Millisecond}
	appDataDir                = filepath.Join(os.Getenv("APPDATA"), "Utilizer")
	runtimeDir                = filepath.Join(appDataDir, "runtime")
	logPath                   = filepath.Join(runtimeDir, logName)
	registryPath              = filepath.Join(runtimeDir, "web.json")
	pollInterval              = 5 * time.Second
	healthFailuresBeforeExit  = 3
	startupHealthTimeout      = 20 * time.Second
	healthCheckInterval       = 150 * time.Millisecond
)

type serverProcess struct {
	process *os.Process
	exited  chan error
}

type startupResult struct {
	healthy bool
	reason  string
}

func main() {
	mutex, alreadyRunning, err := acquireSingleInstance()
	if err != nil {
		messageBox("Utilizer", fmt.Sprintf("Utilizer could not start: %v", err), 0x10)
		return
	}
	if alreadyRunning {
		if serverHealthy() {
			openBrowser()
		} else {
			messageBox("Utilizer", "Utilizer is already starting. Wait a moment, then open it again.", 0x40)
		}
		return
	}
	defer closeHandle(mutex)

	systray.Run(onReady, onExit)
}

func onReady() {
	if !ensureServerReady() {
		systray.Quit()
		return
	}

	if icon, err := os.ReadFile(filepath.Join(appDir(), "logo.ico")); err == nil {
		systray.SetIcon(icon)
	}
	systray.SetTooltip("Utilizer")

	openItem := systray.AddMenuItem("Open", "Open Utilizer in your browser")
	copyLoginLinkItem := systray.AddMenuItem("Copy Login Link", "Copy authenticated Utilizer link")
	statusItem := systray.AddMenuItem("Running", "Current Utilizer status")
	statusItem.Disable()
	systray.AddSeparator()
	openDataItem := systray.AddMenuItem("Open Folder", "Open the Utilizer AppData folder")
	systray.AddSeparator()
	stopItem := systray.AddMenuItem("Stop Utilizer", "Stop Utilizer")

	registerTray()
	openBrowser()
	serverWasHealthy = true
	refreshStatus(statusItem)

	go func() {
		for {
			select {
			case <-openItem.ClickedCh:
				openUtilizer(statusItem)
			case <-copyLoginLinkItem.ClickedCh:
				copyLoginLink(statusItem)
			case <-openDataItem.ClickedCh:
				openDataFolder()
			case <-stopItem.ClickedCh:
				stopAndExit(statusItem)
				return
			}
		}
	}()

	go pollServer(statusItem)
}

func onExit() {
	clearTray()
}

func ensureServerReady() bool {
	if serverHealthy() {
		return true
	}
	if !serverPortAvailable() {
		messageBox("Utilizer", fmt.Sprintf("Utilizer cannot start because %s:%d is already in use by another process.", host, port), 0x10)
		return false
	}

	process, err := startServer()
	if err != nil {
		messageBox("Utilizer", err.Error(), 0x10)
		return false
	}
	ownedServerProcess = process

	result := waitForServerHealth(startupHealthTimeout, process)
	if result.healthy {
		return true
	}

	appendTrayLog("startup failed: %s", result.reason)
	messageBox("Utilizer", fmt.Sprintf("Utilizer web app did not start (%s). See %s for details.", result.reason, logPath), 0x10)
	stopOwnedProcess()
	return false
}

func openUtilizer(statusItem *systray.MenuItem) {
	if !serverHealthy() && !ensureServerReady() {
		refreshStatus(statusItem)
		return
	}
	openBrowser()
	serverWasHealthy = true
	refreshStatus(statusItem)
}

func copyLoginLink(statusItem *systray.MenuItem) {
	if !serverHealthy() && !ensureServerReady() {
		refreshStatus(statusItem)
		return
	}

	link, err := loginLink()
	if err != nil {
		messageBox("Utilizer", err.Error(), 0x30)
		refreshStatus(statusItem)
		return
	}
	if err := copyTextToClipboard(link); err != nil {
		messageBox("Utilizer", fmt.Sprintf("Could not copy login link: %v", err), 0x10)
		refreshStatus(statusItem)
		return
	}

	messageBox("Utilizer", "Login link copied to clipboard.", 0x40)
	serverWasHealthy = true
	refreshStatus(statusItem)
}

func pollServer(statusItem *systray.MenuItem) {
	ticker := time.NewTicker(pollInterval)
	defer ticker.Stop()

	for range ticker.C {
		if serverHealthy() {
			serverWasHealthy = true
			consecutiveHealthFailures = 0
			heartbeat()
			refreshStatus(statusItem)
			continue
		}

		consecutiveHealthFailures++
		refreshStatus(statusItem)
		if consecutiveHealthFailures < healthFailuresBeforeExit {
			continue
		}

		if serverWasHealthy && !stopRequested {
			stopRequested = true
			stopOwnedProcess()
			systray.Quit()
			return
		}
	}
}

func stopAndExit(statusItem *systray.MenuItem) {
	stopRequested = true
	shutdown()
	if !waitForServerStopped(3 * time.Second) {
		stopOwnedProcess()
	}
	if waitForServerStopped(2 * time.Second) {
		systray.Quit()
		return
	}

	stopRequested = false
	messageBox("Utilizer", fmt.Sprintf("Utilizer did not stop cleanly. See %s for details.", logPath), 0x30)
	refreshStatus(statusItem)
}

func refreshStatus(statusItem *systray.MenuItem) {
	status := "Running"
	if !serverHealthy() {
		if serverPortAvailable() {
			status = "Stopped"
		} else {
			status = "Port busy"
		}
	}
	statusItem.SetTitle(status)
	systray.SetTooltip("Utilizer - " + status)
}

func serverHealthy() bool {
	resp, err := httpClient.Get(url + "health")
	if err != nil {
		return false
	}
	defer resp.Body.Close()
	body, _ := io.ReadAll(io.LimitReader(resp.Body, 32))
	return resp.StatusCode >= 200 && resp.StatusCode < 300 && strings.TrimSpace(string(body)) == "ok"
}

func serverPortAvailable() bool {
	listener, err := net.Listen("tcp", fmt.Sprintf("%s:%d", host, port))
	if err != nil {
		return false
	}
	_ = listener.Close()
	return true
}

func startServer() (*serverProcess, error) {
	if err := os.MkdirAll(runtimeDir, 0o755); err != nil {
		return nil, err
	}

	cmd, err := resolveServerCommand()
	if err != nil {
		return nil, err
	}

	logFile, err := os.OpenFile(logPath, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0o644)
	if err != nil {
		return nil, err
	}
	writeTrayLog(logFile, "starting web app command=%s dir=%s startup_timeout=%s", commandLine(cmd), cmd.dir, startupHealthTimeout)

	command := exec.Command(cmd.file, cmd.args...)
	command.Dir = cmd.dir
	command.Stdout = logFile
	command.Stderr = logFile
	command.SysProcAttr = hiddenProcessAttributes()

	if err := command.Start(); err != nil {
		writeTrayLog(logFile, "start failed: %v", err)
		_ = logFile.Close()
		return nil, err
	}

	process := &serverProcess{process: command.Process, exited: make(chan error, 1)}
	writeTrayLog(logFile, "web app process started pid=%d", command.Process.Pid)
	go func() {
		err := command.Wait()
		writeTrayLog(logFile, "web app process exited pid=%d status=%s", command.Process.Pid, processExitStatus(err))
		_ = logFile.Close()
		process.exited <- err
		close(process.exited)
	}()
	return process, nil
}

func waitForServerHealth(timeout time.Duration, process *serverProcess) startupResult {
	deadline := time.Now().Add(timeout)
	for {
		if serverHealthy() {
			return startupResult{healthy: true}
		}

		if process != nil {
			select {
			case err, ok := <-process.exited:
				if ok {
					return startupResult{reason: fmt.Sprintf("process exited before health check passed: %s", processExitStatus(err))}
				}
				return startupResult{reason: "process exited before health check passed"}
			default:
			}
		}

		remaining := time.Until(deadline)
		if remaining <= 0 {
			break
		}

		sleepFor := healthCheckInterval
		if remaining < sleepFor {
			sleepFor = remaining
		}
		time.Sleep(sleepFor)
	}

	if serverHealthy() {
		return startupResult{healthy: true}
	}
	return startupResult{reason: fmt.Sprintf("health check timed out after %s", timeout)}
}

func waitForServerStopped(timeout time.Duration) bool {
	deadline := time.Now().Add(timeout)
	for time.Now().Before(deadline) {
		if !serverHealthy() && serverPortAvailable() {
			return true
		}
		time.Sleep(100 * time.Millisecond)
	}
	return !serverHealthy() && serverPortAvailable()
}

func stopOwnedProcess() {
	if ownedServerProcess == nil {
		return
	}
	_ = ownedServerProcess.process.Signal(os.Interrupt)
	if waitForServerStopped(2 * time.Second) {
		return
	}
	_ = ownedServerProcess.process.Kill()
}

func openBrowser() {
	link, err := loginLink()
	if err != nil {
		link = url
	}
	_ = exec.Command("rundll32", "url.dll,FileProtocolHandler", link).Start()
}

func loginLink() (string, error) {
	baseURL, token, err := loginState()
	if err != nil {
		return "", err
	}

	return appendToken(baseURL, token), nil
}

func loginState() (string, string, error) {
	record := map[string]any{}
	data, err := os.ReadFile(registryPath)
	if err != nil {
		return "", "", fmt.Errorf("Could not read Utilizer login state: %v", err)
	}
	if err := json.Unmarshal(data, &record); err != nil {
		return "", "", fmt.Errorf("Utilizer login state is not valid JSON: %v", err)
	}

	baseURL, _ := record["url"].(string)
	token, _ := record["token"].(string)
	baseURL = strings.TrimSpace(baseURL)
	token = strings.TrimSpace(token)
	if baseURL == "" || token == "" {
		return "", "", errors.New("Utilizer login token is not available yet")
	}

	return baseURL, token, nil
}

func appendToken(baseURL string, token string) string {
	separator := "?"
	if strings.Contains(baseURL, "?") {
		separator = "&"
	}
	return baseURL + separator + "token=" + token
}

func openDataFolder() {
	if err := os.MkdirAll(appDataDir, 0o755); err != nil {
		messageBox("Utilizer", fmt.Sprintf("Could not create Utilizer folder: %v", err), 0x10)
		return
	}
	if err := exec.Command("explorer.exe", appDataDir).Start(); err != nil {
		messageBox("Utilizer", fmt.Sprintf("Could not open Utilizer folder: %v", err), 0x10)
	}
}

func heartbeat() {
	post("heartbeat")
}

func shutdown() {
	post("shutdown")
}

func post(path string) {
	requestURL := url + path
	if baseURL, token, err := loginState(); err == nil {
		requestURL = appendToken(baseURL+path, token)
	}

	resp, err := httpClient.Post(requestURL, "text/plain", bytes.NewReader(nil))
	if err != nil {
		return
	}
	_ = resp.Body.Close()
}

func appendTrayLog(format string, args ...any) {
	if err := os.MkdirAll(runtimeDir, 0o755); err != nil {
		return
	}
	logFile, err := os.OpenFile(logPath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o644)
	if err != nil {
		return
	}
	defer logFile.Close()
	writeTrayLog(logFile, format, args...)
}

func writeTrayLog(writer io.Writer, format string, args ...any) {
	timestamp := time.Now().UTC().Format(time.RFC3339)
	_, _ = fmt.Fprintf(writer, "%s tray %s\n", timestamp, fmt.Sprintf(format, args...))
}

func commandLine(command serverCommand) string {
	parts := append([]string{command.file}, command.args...)
	for i, part := range parts {
		if strings.ContainsAny(part, " \t\"") {
			parts[i] = fmt.Sprintf("%q", part)
		}
	}
	return strings.Join(parts, " ")
}

func processExitStatus(err error) string {
	if err == nil {
		return "exit status 0"
	}
	return err.Error()
}

type serverCommand struct {
	file string
	dir  string
	args []string
}

func resolveServerCommand() (serverCommand, error) {
	if explicit := os.Getenv("UTILIZER_WEB_EXE"); explicit != "" {
		if fileExists(explicit) {
			return executableCommand(explicit), nil
		}
	}

	sidecar := filepath.Join(appDir(), sidecarExe)
	if fileExists(sidecar) {
		return executableCommand(sidecar), nil
	}

	if mainPath := findSourceMain(); mainPath != "" {
		return serverCommand{
			file: "ruby",
			dir:  filepath.Dir(mainPath),
			args: []string{mainPath, "serve-web", fmt.Sprint(port)},
		}, nil
	}

	return serverCommand{}, errors.New("could not find utilizer-web.exe next to the tray app")
}

func executableCommand(path string) serverCommand {
	return serverCommand{
		file: path,
		dir:  filepath.Dir(path),
		args: []string{"serve-web", fmt.Sprint(port)},
	}
}

func findSourceMain() string {
	starts := []string{mustGetwd(), appDir()}
	for _, start := range starts {
		dir := filepath.Clean(start)
		for depth := 0; depth < 8; depth++ {
			mainPath := filepath.Join(dir, "main.rb")
			if fileExists(mainPath) {
				return mainPath
			}
			parent := filepath.Dir(dir)
			if parent == dir {
				break
			}
			dir = parent
		}
	}
	return ""
}

func appDir() string {
	exe, err := os.Executable()
	if err != nil {
		return mustGetwd()
	}
	return filepath.Dir(exe)
}

func mustGetwd() string {
	dir, err := os.Getwd()
	if err != nil {
		return "."
	}
	return dir
}

func fileExists(path string) bool {
	info, err := os.Stat(path)
	return err == nil && !info.IsDir()
}

func registerTray() {
	updateRegistry(map[string]any{
		"tray_pid":        os.Getpid(),
		"tray_started_at": time.Now().UTC().Format(time.RFC3339Nano),
	})
}

func clearTray() {
	updateRegistry(map[string]any{
		"tray_pid":        nil,
		"tray_started_at": nil,
	})
}

func updateRegistry(values map[string]any) {
	if err := os.MkdirAll(runtimeDir, 0o755); err != nil {
		return
	}

	current := map[string]any{}
	if data, err := os.ReadFile(registryPath); err == nil {
		_ = json.Unmarshal(data, &current)
	}
	for key, value := range values {
		if value == nil {
			delete(current, key)
		} else {
			current[key] = value
		}
	}
	if len(current) == 0 {
		_ = os.Remove(registryPath)
		return
	}
	data, err := json.MarshalIndent(current, "", "  ")
	if err == nil {
		_ = os.WriteFile(registryPath, append(data, '\n'), 0o644)
	}
}
