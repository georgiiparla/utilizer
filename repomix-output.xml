class Utilizer
  module Maps
    SLUG = ->(value) { value.to_s.downcase.gsub(/[^a-z0-9]+/, "_").gsub(/\A_+|_+\z/, "") }

    SUPPORTED = [
      { code: "de_mirage", name: "Mirage",
        icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_mirage.png" },
      { code: "de_inferno", name: "Inferno",
        icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_inferno.png" },
      { code: "de_nuke", name: "Nuke",
        icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_nuke.png" },
      { code: "de_overpass", name: "Overpass",
        icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_overpass.png" },
      { code: "de_ancient", name: "Ancient",
        icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_ancient.png" },
      { code: "de_anubis", name: "Anubis",
        icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_anubis.png" },
      { code: "de_dust2", name: "Dust II",
        icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_dust2.png" },
      { code: "de_cache", name: "Cache",
        icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_cache.png" },
      { code: "de_train", name: "Train",
        icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_train.png" },
      { code: "de_vertigo", name: "Vertigo", icon: "https://raw.githubusercontent.com/MurkyYT/cs2-map-icons/main/images/de_vertigo.png" }
    ].freeze

    BY_CODE = SUPPORTED.to_h { |map| [map.fetch(:code), map] }.freeze
    BY_NAME = SUPPORTED.to_h { |map| [SLUG.call(map.fetch(:name)), map] }.freeze
    FOLDER_CODES = SUPPORTED.map { |map| map.fetch(:code) }.freeze

    module_function

    def supported
      SUPPORTED
    end

    def folder_codes
      FOLDER_CODES
    end

    def supported?(code)
      BY_CODE.key?(code.to_s)
    end

    def valid_folder?(code)
      FOLDER_CODES.include?(code.to_s)
    end

    def canonical(value)
      text = value.to_s.strip
      normalized = slug(text)
      return normalized if supported?(normalized)
      return BY_NAME.fetch(normalized).fetch(:code) if BY_NAME.key?(normalized)

      nil
    end

    def validate_folder!(code)
      normalized = canonical(code)
      raise "Unsupported map folder: #{code}" unless valid_folder?(normalized)

      normalized
    end

    def label(code)
      BY_CODE.fetch(validate_folder!(code)).fetch(:code)
    end

    def alias_map(code)
      validate_folder!(code)
    end

    def strip_redundant_prefix(name, map_code)
      normalized = validate_folder!(map_code)
      text = name.to_s
      prefix = "#{normalized}_"
      return text unless text.downcase.start_with?(prefix)
      return text if text.length <= prefix.length

      text[prefix.length..]
    end

    def slug(value)
      SLUG.call(value)
    end
  end
end
